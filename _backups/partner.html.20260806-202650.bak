?<!DOCTYPE html>
<html lang="sq">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Partner — Savoraapp</title>
  <meta name="description" content="Fitoni të ardhura shtesë nga ushqimi që do ta hidhnit. Mbushni kapacitetin bosh dhe tërhiqni klientë të rinj — pa rrezik.">
  <meta name="theme-color" content="#10b981">
  <meta name="verify-Paysera" content="39ffaa4a0a96b7334c68bf29f1f24704">
  <link rel="manifest" href="manifest.json">
  <link rel="icon" href="icons/favicon.ico">
  <link rel="apple-touch-icon" href="icons/apple-touch-icon.png">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="tailwind-built.css">
  <style>
    body { font-family: 'Inter', system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
    .glass-card { background: rgba(255,255,255,0.05); backdrop-filter: blur(20px) saturate(160%); -webkit-backdrop-filter: blur(20px) saturate(160%); border: 1px solid rgba(255,255,255,0.08); }
    .hero-grad { background: linear-gradient(145deg, #0F172A 0%, #1E293B 40%, #064E3B 100%); }
    @keyframes fI { from{opacity:0;transform:translateY(30px)} to{opacity:1;transform:translateY(0)} }
    @keyframes fl { 0%,100%{transform:translateY(0)rotate(0)} 50%{transform:translateY(-20px)rotate(2deg)} }
    @keyframes fl2 { 0%,100%{transform:translateY(0)rotate(0)} 50%{transform:translateY(-15px)rotate(-2deg)} }
    .an-f { animation: fI 0.7s ease-out forwards; opacity:0; }
    .delay-1 { animation-delay: 0.1s; }
    .delay-2 { animation-delay: 0.2s; }
    .delay-3 { animation-delay: 0.3s; }
    .delay-4 { animation-delay: 0.4s; }
    .float1 { animation: fl 7s ease-in-out infinite; }
    .float2 { animation: fl2 8s ease-in-out infinite; animation-delay: 1s; }
    .btn-p {
      background: linear-gradient(135deg, #10B981, #34D399);
      transition: all 0.25s ease;
      box-shadow: 0 4px 18px rgba(16,185,129,0.35);
    }
    .btn-p:hover { transform: scale(1.03); box-shadow: 0 8px 30px rgba(16,185,129,0.45); }
    .btn-p:active { transform: scale(0.97); }
    .ch { transition: all 0.3s ease; }
    .ch:hover { border-color: #10B981; transform: translateY(-4px); box-shadow: 0 20px 40px rgba(0,0,0,0.06); }
  </style>
  <script src="js/config.js" type="76445a00c4b4d42382252849-text/javascript"></script>
  <meta name="verify-paysera" content="39ffaa4a0a96b7334c68bf29f1f24704">
</head>
<body class="bg-sav-light text-sav-dark antialiased">

  <!-- ========== HEADER ========== -->
  <header id="hdr" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between h-16 sm:h-20">
        <a href="index.html" class="flex items-center gap-2.5 group">
          <div class="w-9 h-9 sm:w-10 sm:h-10 rounded-xl flex items-center justify-center text-white font-bold text-lg shadow-lg" style="background:linear-gradient(135deg,#10B981,#34D399);">S</div>
          <span class="text-lg sm:text-xl font-bold tracking-tight text-sav-green">Savora<span class="text-emerald-300">app</span></span>
        </a>
        <div class="flex items-center gap-2 sm:gap-3">
          <button type="button" onclick="if (!window.__cfRLUnblockHandlers) return false; toggleLang()" id="langBtn" class="px-3 py-2 text-sm font-semibold text-sav-green hover:text-sav-greenD border border-sav-grayB rounded-xl transition-colors" data-cf-modified-76445a00c4b4d42382252849-="">EN</button>
          <a href="partner-dashboard.html" class="hidden sm:block px-5 py-2 text-sm font-semibold text-white bg-gradient-to-r from-sav-green to-emerald-500 hover:from-emerald-600 hover:to-emerald-700 rounded-xl shadow-lg shadow-emerald-200/50 transition-all" id="navLoginBtn"><span data-en='Log in'>Hyr</span></a>
          <div class="hidden items-center gap-2" id="userLoggedIn">
            <span class="text-sm font-semibold text-sav-green" id="userDisplayName"></span>
            <button onclick="if (!window.__cfRLUnblockHandlers) return false; logoutUser()" class="text-xs text-sav-gray hover:text-sav-rose underline" data-cf-modified-76445a00c4b4d42382252849-=""><span data-en='Log out'>Dil</span></button>
          </div>
          <a href="partner-dashboard.html?tab=register" class="btn-p px-4 sm:px-6 py-2 text-white text-sm font-semibold rounded-xl"><span data-en='Become a partner'>Bëhu partner</span></a>
          <button onclick="if (!window.__cfRLUnblockHandlers) return false; toggleMobileMenu()" class="lg:hidden p-2 text-sav-green hover:text-sav-greenD" data-cf-modified-76445a00c4b4d42382252849-="">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- Mobile Menu -->
  <div id="mob" class="fixed inset-0 z-[55] hidden lg:hidden">
    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="if (!window.__cfRLUnblockHandlers) return false; toggleMobileMenu()" data-cf-modified-76445a00c4b4d42382252849-=""></div>
    <div class="absolute right-0 top-0 bottom-0 w-72 bg-white shadow-2xl p-6 pt-20 transform transition-transform duration-300 translate-x-full" id="mobP">
      <button onclick="if (!window.__cfRLUnblockHandlers) return false; toggleMobileMenu()" class="absolute top-4 right-4 p-2 text-sav-gray hover:text-sav-dark" data-cf-modified-76445a00c4b4d42382252849-=""><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
      <nav class="flex flex-col gap-1">
        <a href="index.html" class="px-4 py-3 text-sav-dark hover:bg-sav-grayS rounded-xl"><span data-en='Home'>Kreu</span></a>
        <a href="partner-dashboard.html?tab=register" class="btn-p text-center px-4 py-3 text-white font-semibold rounded-xl mt-2"><span data-en='Become a partner'>Bëhu partner</span></a>
      </nav>
    </div>
  </div>

  <!-- ========== HERO (HOOK) ========== -->
  <section class="hero-grad relative min-h-screen flex items-center overflow-hidden pt-24 sm:pt-28">
    <div class="absolute top-1/4 -left-32 w-96 h-96 bg-sav-green/15 rounded-full blur-[120px] float1 pointer-events-none"></div>
    <div class="absolute bottom-1/4 -right-32 w-[500px] h-[500px] bg-sav-purple/10 rounded-full blur-[120px] float2 pointer-events-none"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 sm:pb-20 w-full">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="text-center lg:text-left">
          <h1 class="an-f text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-[1.1] tracking-tight mb-5">
            <span data-en='Earn extra revenue<br><span class="text-sav-green">from food you would<br>otherwise throw away</span>'>Fitoni të ardhura shtesë<br><span class="text-sav-green">nga ushqimi që<br>do ta hidhnit</span></span>
          </h1>
          <p class="an-f delay-1 text-lg sm:text-xl text-sav-grayL/80 leading-relaxed mb-8 max-w-lg mx-auto lg:mx-0">
            <span data-en='Fill empty capacity and attract new customers — risk-free'>Mbushni kapacitetin bosh dhe tërhiqni klientë të rinj — pa rrezik</span>
          </p>
          <div class="an-f delay-2 mb-10">
            <a href="#register" class="btn-p px-8 sm:px-10 py-4 text-white font-semibold rounded-xl inline-flex items-center justify-center gap-2 text-base sm:text-lg">
              <span data-en='Become a partner'>Bëhu partner</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
            </a>
          </div>

          <!-- Hard proof row -->
          <div class="an-f delay-3 flex flex-wrap items-center gap-x-6 gap-y-3 max-w-lg mx-auto lg:mx-0">
            <div class="flex items-center gap-2 text-sav-grayL/90 text-sm">
              <div class="w-8 h-8 rounded-lg bg-sav-green/20 flex items-center justify-center text-sav-green flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
              </div>
              <span class="font-semibold text-white">86+</span> <span><span data-en='active partners'>partnerë aktivë</span></span>
            </div>
            <div class="flex items-center gap-2 text-sav-grayL/90 text-sm">
              <div class="w-8 h-8 rounded-lg bg-sav-green/20 flex items-center justify-center text-sav-green flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              </div>
              <span class="font-semibold text-white">15.000–50.000 Lek</span> <span><span data-en='extra/week'>ekstra/javë</span></span>
            </div>
            <div class="flex items-center gap-2 text-sav-grayL/90 text-sm">
              <div class="w-8 h-8 rounded-lg bg-sav-green/20 flex items-center justify-center text-sav-green flex-shrink-0">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
              </div>
              <span class="font-semibold text-white">5 min</span> <span><span data-en='and you are live'>dhe je live</span></span>
            </div>
          </div>
        </div>

        <!-- Visual -->
        <div class="an-f delay-1 relative hidden lg:block">
          <div class="relative">
            <div class="rounded-3xl overflow-hidden shadow-2xl border border-white/10" style="box-shadow:0 32px 64px rgba(0,0,0,0.4);">
              <img src="https://images.unsplash.com/photo-1556740758-90de374c12ad?w=800&h=500&fit=crop" alt="Partner winkel" class="w-full h-[400px] xl:h-[460px] object-cover">
              <div class="absolute inset-0 bg-gradient-to-t from-sav-dark/60 via-transparent to-transparent"></div>
            </div>
            <div class="glass-card absolute -bottom-4 -left-4 xl:-left-8 rounded-2xl p-4 sm:p-5 max-w-[220px]" style="animation:fl 6s ease-in-out infinite;">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sav-green to-emerald-300 flex items-center justify-center text-white shrink-0 text-lg">💰</div>
                <div>
                  <p class="text-sm font-semibold text-white">+35.000 Lek<span data-en='/week'>/javë</span></p>
                  <p class="text-xs text-sav-grayL/70"><span data-en='avg. partner'>mes. partneri</span></p>
                </div>
              </div>
            </div>
            <div class="glass-card absolute -top-3 -right-3 xl:-right-6 rounded-2xl p-3" style="animation:fl2 7s ease-in-out infinite 0.5s;">
              <div class="flex items-center gap-2">
                <div class="w-7 h-7 rounded-full bg-sav-rose flex items-center justify-center text-white text-xs font-bold">+</div>
                <span class="text-xs text-sav-grayL font-medium"><span data-en='86+ partners'>86+ partnerë</span></span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-32 bg-gradient-to-t from-sav-light to-transparent"></div>
  </section>

  <!-- ========== VOORDELEN ========== -->
  <section class="py-14 sm:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 sm:mb-12">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-sav-greenL text-sav-greenD mb-4"><span data-en='Benefits'>Përfitimet</span></span>
        <h2 class="text-2xl sm:text-4xl font-bold text-sav-dark tracking-tight mb-3"><span data-en='Why you will want this'>Pse ta zgjedhni</span></h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6">
        <div class="bg-sav-light rounded-2xl p-6 border border-sav-grayB/50 ch text-center">
          <div class="w-12 h-12 rounded-xl bg-sav-greenL flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-sav-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-base text-sav-dark mb-2"><span data-en='Extra revenue'>Të ardhura shtesë</span></h3>
          <p class="text-sm text-sav-gray"><span data-en='Sell what you would otherwise throw away. 15,000–50,000 Lek extra per week.'>Shisni atë që do ta hidhnit. 15.000–50.000 Lek ekstra në javë.</span></p>
        </div>
        <div class="bg-sav-light rounded-2xl p-6 border border-sav-grayB/50 ch text-center">
          <div class="w-12 h-12 rounded-xl bg-sav-greenL flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-sav-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </div>
          <h3 class="font-bold text-base text-sav-dark mb-2"><span data-en='New customers'>Klientë të rinj</span></h3>
          <p class="text-sm text-sav-gray"><span data-en='Bring new customers to your shop. Every week.'>Tërhiqni klientë të rinj në dyqanin tuaj. Çdo javë.</span></p>
        </div>
        <div class="bg-sav-light rounded-2xl p-6 border border-sav-grayB/50 ch text-center">
          <div class="w-12 h-12 rounded-xl bg-sav-greenL flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-sav-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-base text-sav-dark mb-2"><span data-en='No fixed costs'>Pa kosto fikse</span></h3>
          <p class="text-sm text-sav-gray"><span data-en='You set prices and availability. No subscription.'>Ju vendosni çmimet dhe disponueshmërinë. Pa abonim.</span></p>
        </div>
        <div class="bg-sav-light rounded-2xl p-6 border border-sav-grayB/50 ch text-center">
          <div class="w-12 h-12 rounded-xl bg-sav-greenL flex items-center justify-center mb-4 mx-auto">
            <svg class="w-6 h-6 text-sav-green" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <h3 class="font-bold text-base text-sav-dark mb-2"><span data-en='Less waste'>Më pak mbetje</span></h3>
          <p class="text-sm text-sav-gray"><span data-en='Contribute to a more sustainable world. Good for your image.'>Kontribuoni për një botë më të qëndrueshme. Mirë për imazhin tuaj.</span></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ========== HOE HET WERKT (SNAPPY) ========== -->
  <section id="flow" class="py-14 sm:py-20 bg-sav-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 sm:mb-12">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-sav-greenL text-sav-greenD mb-4"><span data-en='How it works'>Si funksionon</span></span>
        <h2 class="text-2xl sm:text-4xl font-bold text-sav-dark tracking-tight mb-3"><span data-en='How it works'>Si funksionon</span></h2>
        <p class="text-sav-gray max-w-md mx-auto"><span data-en='Fast, simple, hassle-free'>Shpejt, thjesht, pa siklet</span></p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 lg:gap-8">
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-sav-grayB/50 ch text-center">
          <div class="w-14 h-14 rounded-full bg-sav-green text-white flex items-center justify-center text-xl font-bold mx-auto mb-5">1</div>
          <h3 class="font-bold text-lg text-sav-dark mb-2"><span data-en='Post your deals <span class="text-sav-green">(2 min)</span>'>Publikoni ofertat <span class="text-sav-green">(2 min)</span></span></h3>
          <p class="text-sm text-sav-gray"><span data-en='Create a surprise box with your surplus in 2 minutes.'>Krijoni në 2 minuta një kuti surprizë me tepricën tuaj.</span></p>
        </div>
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-sav-grayB/50 ch text-center">
          <div class="w-14 h-14 rounded-full bg-sav-green text-white flex items-center justify-center text-xl font-bold mx-auto mb-5">2</div>
          <h3 class="font-bold text-lg text-sav-dark mb-2"><span data-en='Customers reserve <span class="text-sav-green">instantly</span>'>Klientët rezervojnë <span class="text-sav-green">menjëherë</span></span></h3>
          <p class="text-sm text-sav-gray"><span data-en='Customers see your deal and reserve instantly via the app.'>Klientët shohin ofertën dhe rezervojnë menjëherë përmes aplikacionit.</span></p>
        </div>
        <div class="bg-white rounded-2xl p-6 sm:p-8 border border-sav-grayB/50 ch text-center">
          <div class="w-14 h-14 rounded-full bg-sav-green text-white flex items-center justify-center text-xl font-bold mx-auto mb-5">3</div>
          <h3 class="font-bold text-lg text-sav-dark mb-2"><span data-en='They pick up & <span class="text-sav-green">pay</span>'>Ata e marrin & <span class="text-sav-green">paguajnë</span></span></h3>
          <p class="text-sm text-sav-gray"><span data-en='Customers pick up at the agreed time — you get the revenue.'>Klientët e marrin në kohën e caktuar — ju merrni të ardhurat.</span></p>
        </div>
      </div>
      <!-- CTA -->
      <div class="text-center mt-10">
        <a href="#register" class="btn-p px-8 py-3.5 text-white font-semibold rounded-xl inline-flex items-center justify-center gap-2 text-base">
          <span data-en='Become a partner'>Bëhu partner</span>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ========== KAART ========== -->
  <section class="py-14 sm:py-20 bg-sav-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-10">
        <span class="inline-block px-4 py-1.5 rounded-full text-xs font-semibold bg-sav-greenL text-sav-greenD mb-4"><span data-en='Map'>Harta</span></span>
        <h2 class="text-2xl sm:text-4xl font-bold text-sav-dark tracking-tight mb-3"><span data-en='Where we are active'>Ku jemi aktivë</span></h2>
        <p class="text-sav-gray max-w-md mx-auto"><span data-en='See our partners on the map. Click a marker for more information.'>Shikoni partnerët tanë në hartë. Klikoni një shënues për më shumë informacion.</span></p>
      </div>
      <div class="rounded-2xl overflow-hidden border border-sav-grayB/50 shadow-lg" style="height: 400px;">
        <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d23970.5!2d19.456!3d41.323!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x134fda3e6c02e9c3%3A0x5e2e2c0f2e0e0e0e!2sDurr%C3%ABs%2C%20Albani%C3%AB!5e0!3m2!1snl!2snl!4v1699900000000!5m2!1snl!2snl" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
      <div class="flex flex-wrap justify-center gap-3 mt-6">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-sav-greenL rounded-full text-xs font-semibold text-sav-greenD">
          <span class="w-2 h-2 rounded-full bg-sav-green"></span>
