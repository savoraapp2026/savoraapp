  <script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script type="76445a00c4b4d42382252849-text/javascript">
    // ===== CONFIG =====
    var API_BASE = (window.SAVORA_CONFIG && window.SAVORA_CONFIG.API_BASE) || '';
    if (!API_BASE) API_BASE = 'https://savoraapp.sparkling-scene-16e3.workers.dev';
    var API_URL = API_BASE.replace(/\/$/, '') + '/api';

    var currentVerifyCode = '';
    var partnerFormData = {};
    var currentPartnerId = '';

    // ===== MOBILE MENU =====
    function toggleMobileMenu() {
      var m = document.getElementById('mob');
      var p = document.getElementById('mobP');
      if (m.classList.contains('hidden')) {
        m.classList.remove('hidden');
        setTimeout(function() { p.classList.remove('translate-x-full'); }, 10);
        document.body.style.overflow = 'hidden';
      } else {
        p.classList.add('translate-x-full');
        setTimeout(function() { m.classList.add('hidden'); }, 300);
        document.body.style.overflow = '';
      }
    }

    // ===== HEADER SCROLL =====
    var hdr = document.getElementById('hdr');
    window.addEventListener('scroll', function() {
      if (window.scrollY > 50) {
        hdr.classList.add('bg-white/90', 'backdrop-blur-xl', 'shadow-sm', 'border-b', 'border-sav-grayB/50');
      } else {
        hdr.classList.remove('bg-white/90', 'backdrop-blur-xl', 'shadow-sm', 'border-b', 'border-sav-grayB/50');
      }
    }, { passive: true });

    // ===== LOGIN STATUS =====
    function checkLoginStatus() {
      var user = JSON.parse(localStorage.getItem('savoraapp_user') || 'null');
      var loginBtn = document.getElementById('navLoginBtn');
      var userLoggedDiv = document.getElementById('userLoggedIn');
      var userNameSpan = document.getElementById('userDisplayName');

      if (user && user.email) {
        if (loginBtn) loginBtn.classList.add('hidden');
        if (userLoggedDiv) {
          userLoggedDiv.classList.remove('hidden');
          userLoggedDiv.style.display = 'flex';
        }
        if (userNameSpan) {
          userNameSpan.textContent = user.name || user.email.split('@')[0];
        }
      } else {
        if (loginBtn) loginBtn.classList.remove('hidden');
        if (userLoggedDiv) {
          userLoggedDiv.classList.add('hidden');
          userLoggedDiv.style.display = 'none';
        }
      }
    }

    function logoutUser() {
      localStorage.removeItem('savoraapp_user');
      localStorage.removeItem('auth_token');
      localStorage.removeItem('user_role');
      localStorage.removeItem('is_logged_in');
      window.location.reload();
    }

    function openAuth(type) {
      window.location.href = 'partner-dashboard.html';
    }

    function showPartnerChoice() {
      var el = document.getElementById('partnerChoice');
      if (el) {
        el.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    function hidePartnerChoice() {
      var el = document.getElementById('partnerChoice');
      if (el) {
        el.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    // ===== PARTNER FORM =====
    function handlePartnerForm(e) {
      e.preventDefault();
      var business  = document.getElementById('pfBusiness').value.trim();
      var contact   = document.getElementById('pfContact').value.trim();
      var password  = document.getElementById('pfPassword').value;
      var nipt      = document.getElementById('pfNipt').value.trim();
      var city      = document.getElementById('pfCity').value;

      // Validatie
      if (!password || password.length < 6) {
        showToast('Fjalëkalimi duhet të jetë të paktën 6 karaktere');
        document.getElementById('pfPassword').focus();
        return;
      }
      if (!nipt) {
        showToast('Numri NIPT është i detyrueshëm');
        document.getElementById('pfNipt').focus();
        return;
      }
      if (!city) {
        showToast('Zgjidhni një qytet');
        return;
      }

      var btn = e.target.querySelector('button[type="submit"]');
      var originalText = btn.textContent;
      btn.textContent = 'Duke u procesuar...';
      btn.disabled = true;

      partnerFormData = {
        business: business,
        contact: contact,
        password: password,
        nipt: nipt,
        city: city,
      };

      fetch(API_URL + '/partner/register', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(partnerFormData),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        btn.textContent = originalText;
        btn.disabled = false;

        if (data.success && data.emailSent !== false) {
          currentPartnerId = data.id;
          localStorage.setItem('savora_partner_id', currentPartnerId);

          document.getElementById('partnerForm').classList.add('hidden');
          document.getElementById('verifyStep').classList.remove('hidden');
          setTimeout(function() {
            document.getElementById('verifyCodeInput').focus();
          }, 100);
          showToast('Kontrolloni emailin për kodin e verifikimit!');
        } else if (data.success && data.emailSent === false) {
          console.error('[REGISTER] Email niet verstuurd:', data.emailError);
          showToast('Nuk mund ta dërguam emailin e verifikimit. Kontrolloni adresën tuaj të emailit.');
        } else {
          showToast(data.error || 'Diçka shkoi keq');
        }
      })
      .catch(function() {
        btn.textContent = originalText;
        btn.disabled = false;
        showToast('Gabim rrjeti. Kontrolloni lidhjen tuaj.');
      });
    }

    // ===== VERIFY CODE =====
    function verifyCode() {
      var inputCode = document.getElementById('verifyCodeInput').value.trim();
      var partnerId = localStorage.getItem('savora_partner_id');

      if (!inputCode || inputCode.length !== 6) {
        showToast('Vendosni një kod të vlefshëm 6-shifror');
        return;
      }

      if (!partnerId) {
        showToast('Sesioni skadoi. Rifreskoni faqen dhe regjistrohuni sërish.');
        return;
      }

      fetch(API_URL + '/partner/verify', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: partnerId, code: inputCode }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success && data.token) {
          // VERIFICATIE SUCCESVOL
          // 1. Token EERST opslaan (voor redirect)
          localStorage.setItem('partnerToken', data.token);
          localStorage.setItem('partner_id', data.partnerId || '');
          localStorage.setItem('savora_partner_verified', 'true');
          // 2. Dan pas UI update + redirect
          showSuccess(data);
        } else {
          // VERIFICATIE MISLUKT
          document.getElementById('verifyError').classList.remove('hidden');
          showToast(data.error || 'Kod i pavlefshëm. Provoni sërish.');
          document.getElementById('verifyCodeInput').value = '';
          document.getElementById('verifyCodeInput').focus();
        }
      })
      .catch(function(err) {
        console.error('Verify error:', err);
        showToast('Nuk mund të lidhemi me serverin.');
      });
    }

    // ===== SHOW SUCCESS =====
    // Token is AL opgeslagen in verifyCode(). 
    // Deze functie doet alleen UI update en redirect.
    function showSuccess(data) {
      // 1. Sla partnerinfo op voor dashboard weergave
      localStorage.setItem('savora_partner_email', partnerFormData.contact || '');
      localStorage.setItem('savoraapp_user', JSON.stringify({
        email:  partnerFormData.contact || '',
        name:   partnerFormData.business || '',
        role:   'partner',
        city:   partnerFormData.city || '',
        nipt:   partnerFormData.nipt || '',
      }));

      // 2. Opruimen
      localStorage.removeItem('savora_partner_code');
      localStorage.removeItem('savora_partner_id');

      // 3. Toon success UI
      document.getElementById('verifyStep').classList.add('hidden');
      document.getElementById('successStep').classList.remove('hidden');
      showToast('Verifikimi u krye me sukses!');

      // 4. Redirect naar dashboard na 1 seconde
      // (timeout zodat localStorage writes afgerond zijn)
      setTimeout(function() {
        window.location.href = 'partner-dashboard.html';
      }, 1000);
    }

    // ===== RESEND CODE =====
    function resendCode() {
      var partnerId = localStorage.getItem('savora_partner_id');
      if (!partnerId) {
        showToast('Sesioni skadoi. Rifreskoni faqen.');
        return;
      }

      fetch(API_URL + '/partner/resend', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: partnerId }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        document.getElementById('verifyCodeInput').value = '';
        document.getElementById('verifyError').classList.add('hidden');
        showToast('Kodi i ri u dërgua! Kontrolloni emailin.');
      })
      .catch(function() {
        showToast('Nuk mund të dërgohet kodi. Provoni sërish.');
      });
    }

    function sendEmailWithCode() {
      resendCode();
    }

    // ===== CREDITS SELECTEREN =====
    function selectCredits(plan) {
      var plans = {
        basic:   { name: 'Bazë',    amount: 500,  credits: 25  },
        popular: { name: 'Popullor', amount: 1000, credits: 60  },
        pro:     { name: 'Pro',      amount: 2000, credits: 140 },
      };

      var selected = plans[plan];
      if (!selected) return;

      localStorage.setItem('selected_plan', JSON.stringify(selected));
      showToast('Po fillon pagesa për paketën ' + selected.name + '...');

      fetch(API_URL + '/paysera/create', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          orderId: 'credits_' + Date.now(),
          amount: selected.amount,
          plan: plan,
        }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.paymentUrl) {
          window.location.href = data.paymentUrl;
        } else {
          showToast('Nuk mund të fillojë pagesa.');
        }
      })
      .catch(function() {
        showToast('Gabim rrjeti gjatë pagesës.');
      });
    }

    // ===== TOAST =====
    function showToast(msg) {
      var t = document.createElement('div');
      t.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 bg-sav-dark text-white px-5 py-2.5 rounded-xl text-sm font-medium shadow-xl z-[9999] transition-opacity duration-300';
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(function() {
        t.style.opacity = '0';
        setTimeout(function() { t.remove(); }, 300);
      }, 3000);
    }

    // ===== INIT =====
    document.addEventListener('DOMContentLoaded', function() {
      checkLoginStatus();

      // Enter toets op verificatie input
      var verifyInput = document.getElementById('verifyCodeInput');
      if (verifyInput) {
        verifyInput.addEventListener('keypress', function(e) {
          if (e.key === 'Enter') verifyCode();
        });
        // Alleen cijfers toestaan
        verifyInput.addEventListener('input', function() {
          this.value = this.value.replace(/[^0-9]/g, '');
        });
      }
    });

    // ===== TAAL / LANGUAGE TOGGLE (SQ <-> EN) =====
    function applyLang(lang){
      document.documentElement.lang = lang;
      try { localStorage.setItem('savora_lang', lang); } catch(e){}
      var els = document.querySelectorAll('[data-en]');
      for (var i=0;i<els.length;i++){
        var el = els[i];
        if (el.getAttribute('data-sq') === null) el.setAttribute('data-sq', el.innerHTML);
        el.innerHTML = (lang==='en') ? el.getAttribute('data-en') : el.getAttribute('data-sq');
      }
      var phs = document.querySelectorAll('[data-en-ph]');
      for (var j=0;j<phs.length;j++){
        var pe = phs[j];
        if (pe.getAttribute('data-sq-ph') === null) pe.setAttribute('data-sq-ph', pe.getAttribute('placeholder')||'');
        pe.setAttribute('placeholder', (lang==='en') ? pe.getAttribute('data-en-ph') : pe.getAttribute('data-sq-ph'));
      }
      var ops = document.querySelectorAll('[data-en-opt]');
      for (var k=0;k<ops.length;k++){
        var oe = ops[k];
        if (oe.getAttribute('data-sq-opt') === null) oe.setAttribute('data-sq-opt', oe.textContent);
        oe.textContent = (lang==='en') ? oe.getAttribute('data-en-opt') : oe.getAttribute('data-sq-opt');
      }
      var lb = document.getElementById('langBtn');
      if (lb) lb.textContent = (lang==='en') ? 'SQ' : 'EN';
    }
    function toggleLang(){
      var cur = (document.documentElement.lang==='en') ? 'en' : 'sq';
      applyLang(cur==='en' ? 'sq' : 'en');
    }
    document.addEventListener('DOMContentLoaded', function(){
      var saved = 'sq';
      try { saved = localStorage.getItem('savora_lang') || 'sq'; } catch(e){}
      applyLang(saved==='en' ? 'en' : 'sq');
    });
  </script>
