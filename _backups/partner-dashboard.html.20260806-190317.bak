  // ========================================
  // STATE
  // ========================================
  var currentLang = localStorage.getItem('partnerLang') || 'sq';
  var partnerToken = localStorage.getItem('partnerToken') || '';
  var partnerInfo = null;
  var selectedPackageId = 0;
  var API_BASE = (window.SAVORA_CONFIG && window.SAVORA_CONFIG.API_BASE) || 'https://savoraapp.sparkling-scene-16e3.workers.dev';
  console.log('[API] Using endpoint:', API_BASE);

  // ===== SECURITY HELPERS =====
  function escapeHtml(text) {
    if (text === null || text === undefined) return '';
    return String(text)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  // ========================================
  // PASSWORD TOGGLE (al vroeg gedefinieerd bovenin <head>)
  // ========================================

  // ========================================
  // TRANSLATION ENGINE
  // ========================================
  function setLang(lang) {
    if (lang !== 'en') lang = 'sq';
    currentLang = lang;
    var t = T[lang];
    if (!t) return;
    function tr(key){ return (t && t[key]) || (T['en'] && T['en'][key]) || (T['sq'] && T['sq'][key]) || ''; }

    // Update text content
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n');
      var val = tr(key);
      if (val) {
        if (key === 'payInstructions') {
          el.innerHTML = val;
        } else if (el.querySelector('svg')) {
          // Element heeft SVG - update alleen tekstnodes, behoud SVG
          var textNodes = [];
          el.childNodes.forEach(function(node) {
            if (node.nodeType === 3) textNodes.push(node); // tekstnode
          });
          if (textNodes.length > 0) {
            textNodes[textNodes.length - 1].nodeValue = ' ' + val;
          } else {
            el.appendChild(document.createTextNode(' ' + val));
          }
        } else {
          el.textContent = val;
        }
      }
    });

    // Update placeholders
    document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
      var key = el.getAttribute('data-i18n-placeholder');
      var val = tr(key);
      if (val) el.placeholder = val;
    });

    // Update flag
    var flagMap = {sq:'al',en:'gb',nl:'nl',de:'de',it:'it',gr:'gr',fr:'fr',es:'es',tr:'tr',ar:'sa'};
    var flag = flagMap[lang] || 'al';
    var langFlag = document.getElementById('langFlag');
    var langCode = document.getElementById('langCode');
    if (langFlag) { langFlag.src = 'https://flagcdn.com/w40/' + flag + '.png'; langFlag.alt = lang.toUpperCase(); }
    if (langCode) langCode.textContent = lang.toUpperCase();

    // Update active class
    document.querySelectorAll('.lang-option').forEach(function(opt) {
      opt.classList.toggle('active', opt.getAttribute('data-lang') === lang);
    });

    // Update HTML lang
    document.documentElement.lang = lang === 'gr' ? 'el' : lang === 'ar' ? 'ar' : lang;

    // Store preference
    localStorage.setItem('partnerLang', lang);
  }

  function toggleLangDropdown() {
    document.getElementById('langDropdown').classList.toggle('show');
  }

  document.addEventListener('click', function(e) {
    if (!e.target.closest('.lang-switcher')) {
      var d = document.getElementById('langDropdown');
      if (d) d.classList.remove('show');
    }
  });

  // ========================================
  // LOGIN / REGISTER
  // ========================================
  function switchAuthTab(tab) {
    var loginTab = document.getElementById('loginTab');
    var registerTab = document.getElementById('registerTab');
    var loginSection = document.getElementById('loginFormSection');
    var registerSection = document.getElementById('registerFormSection');
    if (!loginTab || !registerTab) return;
    if (tab === 'login') {
      loginTab.classList.add('active');
      registerTab.classList.remove('active');
      loginSection.classList.add('active');
      registerSection.classList.remove('active');
      document.getElementById('registerError').innerHTML = '';
      document.getElementById('registerSuccess').innerHTML = '';
    } else {
      loginTab.classList.remove('active');
      registerTab.classList.add('active');
      loginSection.classList.remove('active');
      registerSection.classList.add('active');
      document.getElementById('loginError').innerHTML = '';
    }
  }
  // ===== VERIFY REGISTRATION CODE =====
  function verifyRegistrationCode() {
    var inputCode = document.getElementById('verifyCodeInput').value.trim();
    var partnerId = currentPartnerId || localStorage.getItem('savora_partner_id');
    var btn = document.getElementById('verifyCodeBtn');
    var errDiv = document.getElementById('verifyCodeError');
    var succDiv = document.getElementById('verifyCodeSuccess');

    if (!inputCode || inputCode.length !== 6) {
      if (errDiv) { errDiv.textContent = 'Kodi duhet tÃ« ketÃ« 6 shifra'; errDiv.classList.remove('hidden'); }
      return;
    }

    if (btn) btn.textContent = 'Verifikim...';
    if (errDiv) errDiv.classList.add('hidden');

    fetch(API_BASE + '/api/partner/verify', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ id: partnerId, code: inputCode })
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (btn) btn.textContent = document.querySelector('[data-i18n="btnVerify"]')?.getAttribute('data-i18n') || 'Verifiko';
      if (data.success && data.token) {
        // TOKEN OPGESLAGEN
        localStorage.setItem('partnerToken', data.token);
        localStorage.setItem('partner_id', data.partnerId || partnerId);
        localStorage.setItem('savora_partner_verified', 'true');
        if (succDiv) succDiv.innerHTML = '<div class="success-msg">Verifikimi me sukses! Po tÃ« ridrejtojmÃ«...</div>';
        setTimeout(function(){
          window.location.href = 'partner-dashboard.html';
        }, 1500);
      } else {
        if (errDiv) { errDiv.textContent = data.error || 'Kodi i pasakte'; errDiv.classList.remove('hidden'); }
      }
    })
    .catch(function(err){
      console.error('Verify error:', err);
      if (btn) btn.textContent = 'Verifiko';
      if (errDiv) { errDiv.textContent = 'Gabim lidhje. Kontrollo serverin.'; errDiv.classList.remove('hidden'); }
    });
  }

  var resendTimerInterval = null;

  function resendVerifyCodeWithTimer(btn) {
    var partnerId = currentPartnerId || localStorage.getItem('savora_partner_id');
    if (!partnerId) {
      showToast('Gabim: partner ID mungon.');
      return;
    }
    // Disable button
    if (btn) btn.disabled = true;
    var timerEl = document.getElementById('resendCodeTimer');
    var textEl = document.getElementById('resendCodeText');
    var seconds = 60;
    if (timerEl) timerEl.style.display = '';
    if (textEl) textEl.style.display = 'none';
    function updateTimer() {
      if (timerEl) timerEl.textContent = 'RidÃ«rgo (' + seconds + 's)';
      seconds--;
      if (seconds < 0) {
        clearInterval(resendTimerInterval);
        if (btn) btn.disabled = false;
        if (timerEl) timerEl.style.display = 'none';
        if (textEl) textEl.style.display = '';
      }
    }
    updateTimer();
    resendTimerInterval = setInterval(updateTimer, 1000);
    // Send request
    fetch(API_BASE + '/api/partner/resend', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ id: partnerId })
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      showToast('&#128232; Kodi i ri u dÃ«rgua! Kontrollo email-in.');
    })
    .catch(function(){
      showToast('&#9888; Gabim ne ridÃ«rgim. Provoni pÃ«rsÃ«ri.');
    });
  }

  function resendVerifyCode() {
    resendVerifyCodeWithTimer(document.getElementById('resendCodeBtn'));
  }

  function showRegister() {
    switchAuthTab('register');
  }
  function showForgotPassword() {
    document.querySelectorAll('.form-section').forEach(function(s){ s.classList.remove('active'); });
    document.getElementById('forgotPwSection').classList.add('active');
    document.getElementById('loginError').innerHTML = '';
    document.getElementById('forgotPwError').innerHTML = '';
    document.getElementById('forgotPwSuccess').innerHTML = '';
  }
  function showLogin() {
    // Verberg alle sections eerst
    document.querySelectorAll('.form-section').forEach(function(s){ s.classList.remove('active'); });
    // Toon login section
    var loginSection = document.getElementById('loginFormSection');
    if (loginSection) loginSection.classList.add('active');
    // Reset errors
    document.getElementById('forgotPwError').innerHTML = '';
    document.getElementById('forgotPwSuccess').innerHTML = '';
    document.getElementById('resetPwError').innerHTML = '';
    document.getElementById('resetPwSuccess').innerHTML = '';
    // Update tabs
    var loginTab = document.getElementById('loginTab');
    var registerTab = document.getElementById('registerTab');
    if (loginTab) loginTab.classList.add('active');
    if (registerTab) registerTab.classList.remove('active');
  }

  // validateNuiRealtime() al vroeg gedefinieerd in <head>

  function showResetPassword() {
    document.getElementById('loginFormSection').classList.remove('active');
    document.getElementById('registerFormSection').classList.remove('active');
    document.getElementById('forgotPwSection').classList.remove('active');
    document.getElementById('resetPwSection').classList.add('active');
    document.getElementById('resetPwError').innerHTML = '';
    document.getElementById('resetPwSuccess').innerHTML = '';
  }

  // Handle forgot password - shows instruction since backend has no forgot-password endpoint
  document.getElementById('forgotPwForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var t = T[currentLang];
    var btn = document.getElementById('forgotPwBtn');
    var errDiv = document.getElementById('forgotPwError');
    var succDiv = document.getElementById('forgotPwSuccess');
    var email = document.getElementById('forgotPwEmail').value.trim();

    if (!email) {
      errDiv.innerHTML = '<div class="error-msg">' + (t.fillRequired || 'Fill in all required fields') + '</div>';
      return;
    }

    btn.disabled = true;
    btn.textContent = t.btnSending || 'Sending...';
    errDiv.innerHTML = '';
    succDiv.innerHTML = '';

    // Try resend endpoint as fallback (sends new verification code)
    fetch(API_BASE + '/api/partner/resend', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({email: email})
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.disabled = false;
      btn.textContent = t.btnSendReset || 'Send Instructions';
      succDiv.innerHTML = '<div class="success-msg">' + (t.resetEmailSent || 'If this email is registered, you will receive instructions.') + '</div>';
      document.getElementById('forgotPwForm').reset();
    })
    .catch(function(err){
      btn.disabled = false;
      btn.textContent = t.btnSendReset || 'Send Instructions';
      // Soft-fail: show helpful message anyway
      succDiv.innerHTML = '<div class="success-msg">If this email is registered in our system, you will receive a password reset instruction. Please also check your spam folder.</div>';
    });
  });

  // Handle reset password
  document.getElementById('resetPwForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var t = T[currentLang];
    var btn = document.getElementById('resetPwBtn');
    var errDiv = document.getElementById('resetPwError');
    var succDiv = document.getElementById('resetPwSuccess');
    var token = document.getElementById('resetToken').value.trim();
    var newPass = document.getElementById('resetNewPassword').value;

    if (!token || !newPass || newPass.length < 6) {
      errDiv.innerHTML = '<div class="error-msg">' + (t.passwordShort || 'Password must be at least 6 characters') + '</div>';
      return;
    }

    btn.disabled = true;
    btn.textContent = t.btnSending || 'Updating...';

    // Reset password: since backend has no dedicated endpoint, show instructions
    btn.disabled = false;
    btn.textContent = t.btnUpdatePw || 'Update Password';
    succDiv.innerHTML = '<div class="success-msg">To reset your password, please use the "Forgot Password" feature on the login page. A new verification code will be sent to your email.</div>';
    setTimeout(function(){ showLogin(); }, 4000);
  });

  document.getElementById('loginForm').addEventListener('submit', function(e) {
    e.preventDefault();
    console.log('[LOGIN] Submit clicked');
    var t = T[currentLang] || T['en'] || {};
    var btn = document.getElementById('loginBtn');
    var emailEl = document.getElementById('loginEmail');
    var pwEl = document.getElementById('loginPassword');
    if (!emailEl || !pwEl) {
      console.error('[LOGIN] Email or password element not found');
      return;
    }

    var email = emailEl.value.trim();
    var password = pwEl.value;

    btn.disabled = true;
    btn.textContent = t.loginLoading || 'Loading...';
    document.getElementById('loginError').innerHTML = '';

    var loginUrl = API_BASE + '/api/partner/login';
    console.log('[LOGIN] Fetching:', loginUrl);

    fetch(loginUrl, {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({email: email, password: password})
    })
    .then(function(r){
      console.log('[LOGIN] Response status:', r.status);
      return r.json();
    })
    .then(function(data){
      console.log('[LOGIN] Response data:', data);
      btn.disabled = false;
      btn.textContent = t.btnLogin || 'Login';
      if (data.success && data.token) {
        partnerToken = data.token;
        localStorage.setItem('partnerToken', data.token);
        partnerInfo = {name: data.name, business: data.business, email: data.email || email, id: data.partnerId || data.email || email};
        localStorage.setItem('savoraapp_user', JSON.stringify({
          name: data.name || '',
          email: data.email || email,
          business: data.business || '',
          partnerId: data.partnerId || email
        }));
        showDashboard();
      } else if (data.needsVerification) {
        // Nog niet geverifieerd â€” toon verificatie scherm
        localStorage.setItem('savora_partner_id', data.partnerId);
        localStorage.setItem('savora_partner_email', data.contact || email);
        showVerificationScreen(data.partnerId);
      } else {
        document.getElementById('loginError').innerHTML = '<div class="error-msg">' + escapeHtml(data.error || t.invalidCredentials || 'Invalid credentials') + '</div>';
      }
    })
    .catch(function(err){
      console.error('[LOGIN] Fetch error:', err);
      btn.disabled = false;
      btn.textContent = t.btnLogin || 'Login';
      document.getElementById('loginError').innerHTML = '<div class="error-msg">Nuk mund te lidhemi me serverin. Provoni serish me vone ose kontaktoni asistencen.</div>';
    });
  });

  document.getElementById('registerForm').addEventListener('submit', function(e) {
    e.preventDefault();
    var t = T[currentLang];
    var btn = document.getElementById('registerBtn');
    var errDiv = document.getElementById('registerError');
    var succDiv = document.getElementById('registerSuccess');

    var pass = document.getElementById('regPassword').value;
    var confirm = document.getElementById('regConfirmPassword').value;
    var nui = document.getElementById('regNui').value.toUpperCase();

    // Validatie met helper functies
    clearError('registerError');
    if (!document.getElementById('regBusinessName').value || !document.getElementById('regOwnerName').value ||
        !document.getElementById('regEmail').value || !pass || !document.getElementById('regPhone').value) {
      showError('registerError', t.fillRequired);
      return;
    }
    if (!validateNui(nui)) {
      showError('registerError', t.nuiInvalid || 'NUI format i gabuar! Duhet: M12345678O');
      document.getElementById('regNui').focus();
      return;
    }
    if (pass.length < 6) { showError('registerError', t.passwordShort); return; }
    if (pass !== confirm) { showError('registerError', t.passwordMismatch); return; }

    btn.disabled = true;
    btn.textContent = t.registerLoading;

    console.log('[REGISTER] Submitting to:', API_BASE + '/api/partner/register');
    var registerController = new AbortController();
    var registerTimeout = setTimeout(function() { registerController.abort(); }, 8000); // 8 sec timeout
    fetch(API_BASE + '/api/partner/register', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      signal: registerController.signal,
      body: JSON.stringify({
        contact: document.getElementById('regEmail').value,
        password: pass,
        business: document.getElementById('regBusinessName').value,
        nipt: nui,
        city: document.getElementById('regAddress').value || 'Tirana'
      })
    })
    .then(function(r){ 
      clearTimeout(registerTimeout);
      console.log('[REGISTER] Status:', r.status); 
      if (r.status === 409) {
        // Email al geregistreerd
        return r.json().then(function(data) {
          btn.disabled = false;
          btn.textContent = t.btnRegister;
          errDiv.innerHTML = '<div class="error-msg">' + escapeHtml(data.error) + '<br><a href="#" onclick="showLogin();return false;" style="color:var(--primary);text-decoration:underline;">' + (t.alreadyRegisteredLink || 'Klikoni kÃ«tu pÃ«r tÃ« hyrÃ«') + '</a></div>';
          return {alreadyRegistered: true}; // Marker voor volgende .then()
        });
      }
      if (!r.ok) {
        return r.json().then(function(data) {
          throw new Error(data.error || 'Regjistrimi deshtoi');
        });
      }
      return r.json();
    })
    .then(function(data){
      if (!data || data.alreadyRegistered) return; // Al afgehandeld of geen data
      console.log('[REGISTER] Response:', data);
      btn.disabled = false;
      btn.textContent = t.btnRegister;
      if (data.success) {
        currentPartnerId = data.id || '';
        if (data.code) currentVerifyCode = data.code;
        if (currentPartnerId) localStorage.setItem('savora_partner_id', currentPartnerId);
        // Verberg formulier met animatie, toon verificatie
        var regForm = document.getElementById('registerForm');
        var verifySec = document.getElementById('verifyCodeSection');
        regForm.style.opacity = '0';
        regForm.style.transform = 'translateY(-10px)';
        regForm.style.transition = 'all 0.3s ease';
        setTimeout(function() {
          regForm.classList.add('hidden');
          regForm.style.opacity = '';
          regForm.style.transform = '';
          verifySec.classList.remove('hidden');
          verifySec.style.opacity = '0';
          verifySec.style.transform = 'translateY(10px)';
          verifySec.style.transition = 'all 0.3s ease';
          requestAnimationFrame(function() {
            verifySec.style.opacity = '1';
            verifySec.style.transform = 'translateY(0)';
          });
        }, 300);
        succDiv.innerHTML = '<div class="success-msg">' + (t.registerSuccess || 'Registration successful! Check your email for the verification code.') + '</div>';
        showToast('âœ… ' + (t.registerSuccess || 'Registratie gelukt! Check je e-mail.'), 'success');
        setTimeout(function() {
          document.getElementById('verifyCodeInput').value = '';
          document.getElementById('verifyCodeInput').focus();
        }, 400);
      } else {
        errDiv.innerHTML = '<div class="error-msg">' + escapeHtml(data.error || t.registerError || 'Registration failed') + '</div>';
      }
    })
    .catch(function(err){
      console.error('[REGISTER] Error:', err);
      btn.disabled = false;
      btn.textContent = t.btnRegister;
      // Betere error berichten per situatie
      var errorMsg = 'Kan geen verbinding maken met de server. Probeer het later opnieuw.';
      if (err && err.message && err.message.indexOf('Failed to fetch') > -1) {
        errorMsg = 'Geen verbinding met server. Controleer je internetverbinding.';
      } else if (err && err.message && err.message.indexOf('abort') > -1) {
        errorMsg = 'Verzoek duurde te lang. Probeer het opnieuw.';
      } else if (err && err.message) {
        errorMsg = err.message;
      }
      errDiv.innerHTML = '<div class="error-msg">' + escapeHtml(errorMsg) + '</div>';
      showToast(errorMsg, 'error');
    });
  });

  // ========================================
  // MOBILE NAV
  // ========================================
  function toggleMobileNav() {
    var nav = document.getElementById('dashNav');
    var overlay = document.getElementById('mobileNavOverlay');
    nav.classList.toggle('show');
    overlay.classList.toggle('show');
  }

  // ========================================
  // CREDITS DISPLAY
  // ========================================
  function renderCredits() {
    var t = T[currentLang];
    document.getElementById('creditLabel').textContent = t.creditTitle || 'Kredite Aktuale';
    document.getElementById('btnTopUp').textContent = t.btnTopUp || 'BÃ«j Kredi';
    document.getElementById('creditHistoryTitle').textContent = t.creditHistoryTitle || 'Kredite Historiku';
    document.getElementById('creditTooltipText').textContent = t.creditTooltipText || 'Bleni paketa kreditÃ«sh pÃ«r tÃ« postuar ofertat tuaja. 1 kredit = 1 postim. Nuk ka komisione platforme.';

    // Load from API
    var partnerId = partnerInfo ? (partnerInfo.id || partnerInfo.email) : null;
    if (partnerId) {
      loadCreditsFromAPI(partnerId);
    } else {
      // Fallback demo data
      var balance = 0;
      document.getElementById('creditBalance').textContent = balance.toLocaleString();
      document.getElementById('creditMonthly').textContent = '1 kredit = 1 postim';
      var postimeText = {
        sq: 'postime tÃ« mbetura', en: 'posts remaining', nl: 'posts resterend',
        de: 'BeitrÃ¤ge verbleibend', it: 'post rimanenti', gr: 'Ï…Ï€Î¿Î»ÎµÎ¹Ï€ÏŒÎ¼ÎµÎ½ÎµÏ‚ Î´Î·Î¼Î¿ÏƒÎ¹ÎµÏÏƒÎµÎ¹Ï‚',
        fr: 'publications restantes', es: 'publicaciones restantes', tr: 'kalan gÃ¶nderi', ar: 'Ù…Ù†Ø´ÙˆØ±Ø§Øª Ù…ØªØ¨Ù‚ÙŠØ©'
      };
      document.getElementById('creditUsed').textContent = balance + ' ' + (postimeText[currentLang] || postimeText['sq']);
      var bar = document.getElementById('creditProgressBar');
      bar.style.width = balance > 0 ? '100%' : '0%';
      bar.className = 'credit-progress-bar';
      if (balance > 10) bar.classList.add('green');
      else if (balance > 0) bar.classList.add('yellow');
      else bar.classList.add('red');
    }
  }

  // ========================================
  // DASHBOARD
  // ========================================
  function showDashboard() {
    document.getElementById('loginScreen').classList.add('hidden');
    document.getElementById('pricingScreen').style.display = 'none';
    document.getElementById('dashboard').style.display = 'block';
    if (partnerInfo) {
      document.getElementById('userName').textContent = partnerInfo.name || partnerInfo.business || 'Partner';
      document.getElementById('welcomeName').textContent = (partnerInfo.name || 'Partner') + ' | ' + (partnerInfo.business || '');
      document.getElementById('welcomeBusiness').textContent = partnerInfo.email || '';
      document.getElementById('payBusinessName').value = partnerInfo.business || '';
    }
    loadStats();
    renderCredits();
    renderMyBoxes();
    loadMyAds();
    switchTab('overview');
  }

  function showPricing() {
    document.getElementById('loginScreen').classList.add('hidden');
    document.getElementById('pricingScreen').style.display = 'block';
    document.getElementById('dashboard').style.display = 'none';
  }

  function skipPricing() {
    showDashboard();
  }

  function logout() {
    fetch(API_BASE + '/api/partner/logout', {
      method: 'POST',
      headers: {'Authorization': 'Bearer ' + partnerToken}
    }).catch(function(){});
    partnerToken = '';
    partnerInfo = null;
    localStorage.removeItem('partnerToken');
    localStorage.removeItem('savoraapp_user');
    document.getElementById('dashboard').style.display = 'none';
    document.getElementById('pricingScreen').style.display = 'none';
    showLoginScreen();
  }

  function selectPackage(id) {
    selectedPackageId = id;
    var t = T[currentLang];
    var names = {1: '500 LEK - 20 ' + (t.creditsLabel || 'Credits').replace(':','').trim(),
                 2: '1,000 LEK - 50 ' + (t.creditsLabel || 'Credits').replace(':','').trim(),
                 3: '1,800 LEK - 100 ' + (t.creditsLabel || 'Credits').replace(':','').trim()};
    var amounts = {1: 500, 2: 1000, 3: 1800};
    if (confirm(t.pkgSelected + (names[id] || '') + '\n\n' + (t.paymentNote || 'Klik OK om credits te kopen'))) {
      buyCredits(id, amounts[id] || 500);
    }
  }

  function switchTab(tab) {
    document.querySelectorAll('.tab-content').forEach(function(el) { el.style.display = 'none'; });
    document.querySelectorAll('.dash-nav button').forEach(function(el) { el.classList.remove('active'); });
    var tc = document.getElementById('tab-' + tab);
    if (tc) tc.style.display = 'block';
    var nb = document.querySelector('.dash-nav button[data-tab="' + tab + '"]');
    if (nb) nb.classList.add('active');
    if (tab === 'invoices') loadInvoices();
    if (tab === 'boxes') renderMyBoxes();
    if (tab === 'ads') { loadMyAds(); syncFormBalance(); }
    if (tab === 'ofertat') { loadMyDeals(); loadMyClaims(); syncFormBalance(); initAddressMap(); }
  }

  function syncFormBalance() {
    var balEl = document.getElementById('creditBalance');
    var bal = balEl ? (parseInt((balEl.textContent || '0').replace(/\D/g, ''), 10) || 0) : 0;
    var t = T[currentLang] || {};
    var lbl = t.ofKredit || 'kredite';
    function set(id, need){
      var el = document.getElementById(id);
      if (!el) return;
      var ok = bal >= need;
      el.innerHTML = '<span style="color:' + (ok ? 'var(--primary)' : '#dc2626') + '">' +
        (t.creditTitle || 'Kredite') + ': <strong>' + bal + '</strong> ' + lbl + '</span>';
    }
    set('dealBalanceHint', 1);
    var adPlanEl = document.getElementById('adPlan');
    set('adBalanceHint', (adPlanEl && adPlanEl.value === '7d') ? 5 : 3);
  }

  function onAdPlanChange() {
    var sel = document.getElementById('adPlan');
    var btn = document.getElementById('adSubmitBtn');
    var t = T[currentLang] || {};
    var cr = (sel && sel.value === '7d') ? 5 : 3;
    if (btn) btn.textContent = 'Publiko ReklamÃ«n (' + cr + ' ' + (t.ofKredit || 'Kredite') + ')';
    if (typeof syncFormBalance === 'function') syncFormBalance();
  }

  function creditAwareError(msg, need) {
    var t = T[currentLang] || {};
    var isCredit = /credit|kredit|genoeg|actieve/i.test(String(msg || ''));
    var safe = String(msg || '').replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; });
    var text = isCredit
      ? ((t.insufficientCredits || 'Nuk keni kredite tÃ« mjaftueshme') + ' (' + need + ' ' + (t.ofKredit || 'kredite') + ').')
      : safe;
    var cta = isCredit
      ? '<button type="button" onclick="switchTab(\'credits\')" style="margin-top:8px;display:block;width:100%;padding:8px;background:var(--primary);color:#fff;border:none;border-radius:8px;cursor:pointer;font-size:0.8rem">' + (t.btnTopUp || 'Blej Kredite') + '</button>'
      : '';
    return '<div class="error-msg">' + text + cta + '</div>';
  }

  // Set tab data attributes
  document.querySelectorAll('.dash-nav button[data-tab]').forEach(function(btn) {
    // already set in HTML
  });

  // ========================================
  // SURPRISE BOXES
  // ========================================
  var myBoxes = JSON.parse(localStorage.getItem('savora_my_boxes') || '[]');

  function createBox(size) {
    var t = T[currentLang] || {};
    var boxNames = {small: 'Kuti e VogÃ«l', medium: 'Kuti e Mesme', large: 'Kuti e Madhe'};
    var boxPrices = {small: 500, medium: 900, large: 1500};
    var boxData = {
      id: 'box_' + Date.now(),
      size: size,
      name: boxNames[size] || size,
      price: boxPrices[size] || 0,
      status: 'active',
      createdAt: new Date().toISOString().split('T')[0]
    };
    myBoxes.push(boxData);
    localStorage.setItem('savora_my_boxes', JSON.stringify(myBoxes));
    renderMyBoxes();
    showToast((t.boxCreated || 'Kuti u krijua me sukses!') + ' ' + boxData.name);
  }

  function renderMyBoxes() {
    var t = T[currentLang] || {};
    var list = document.getElementById('myBoxesList');
    if (!list) return;
    if (myBoxes.length === 0) {
      list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">' + (t.noBoxes || 'Nuk ka kutitÃ« ende. Krijoni njÃ« kuti surprizÃ«!') + '</p>';
      return;
    }
    list.innerHTML = myBoxes.slice().reverse().map(function(box) {
      var sizeLabel = {small: 'e VogÃ«l', medium: 'e Mesme', large: 'e Madhe'}[box.size] || box.size;
      return '<div class="box-card" style="border:1px solid var(--gray-200);border-radius:10px;padding:12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center">' +
        '<div>' +
          '<strong style="font-size:0.9rem">' + escapeHtml(box.name) + '</strong>' +
          '<div style="font-size:0.75rem;color:var(--gray-500)">' + sizeLabel + ' Â· ' + box.price + ' LEK Â· ' + box.createdAt + '</div>' +
        '</div>' +
        '<span class="badge" style="background:var(--success);color:#fff;font-size:0.7rem;padding:2px 8px;border-radius:10px">' + (box.status === 'active' ? 'Aktive' : 'PÃ«rfunduar') + '</span>' +
      '</div>';
    }).join('');
  }

  // ========================================
  // ADVERTISEMENTS
  // ========================================
  var myAds = [];
  var AD_PRICE_LEK = 200;

  function handleAdSubmit(e) {
    e.preventDefault();
    var t = T[currentLang] || {};
    var btn = document.getElementById('adSubmitBtn');
    var errDiv = document.getElementById('adError');
    var succDiv = document.getElementById('adSuccess');
    var title = document.getElementById('adTitle').value.trim();
    var desc = document.getElementById('adDescription').value.trim();
    var category = document.getElementById('adCategory').value;
    var priceEl = document.getElementById('adPrice');
    var price = priceEl ? priceEl.value.trim() : '';
    var planEl = document.getElementById('adPlan');
    var plan = planEl ? planEl.value : '48h';

    if (errDiv) errDiv.innerHTML = '';
    if (succDiv) succDiv.innerHTML = '';

    if (!title) {
      if (errDiv) errDiv.innerHTML = '<div class="error-msg">' + (t.fillRequired || 'PlotÃ«soni tÃ« gjitha fushat') + '</div>';
      return;
    }

    if (btn) btn.disabled = true;
    var partnerId = partnerInfo ? (partnerInfo.id || partnerInfo.email) : '';

    function resetBtn() {
      if (btn) { btn.disabled = false; btn.textContent = t.btnPublishAd || 'Publiko ReklamÃ«n (3 Kredite)'; }
    }

    // Plaats de advertentie op de server (3 credits) â€” wordt zichtbaar voor klanten
    fetch(API_BASE + '/api/ads', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + partnerToken},
      body: JSON.stringify({ title: title, description: desc, price: price, category: category, plan: plan })
    })
    .then(function(r){ return r.json(); })
    .then(function(d){
      if (d && d.success) {
        var f = document.getElementById('adForm'); if (f) f.reset();
        if (succDiv) succDiv.innerHTML = '<div class="success-msg">' + (t.adPublished || 'Reklama u publikua!') + '</div>';
        loadMyAds();
        if (partnerId && typeof loadCreditsFromAPI === 'function') loadCreditsFromAPI(partnerId);
      } else if (errDiv) {
        errDiv.innerHTML = creditAwareError((d && d.error) || 'Kredite tÃ« pamjaftueshme', 3);
      }
      resetBtn();
    })
    .catch(function(){
      if (errDiv) errDiv.innerHTML = '<div class="error-msg">' + (t.loginError || 'Gabim lidhjeje') + '</div>';
      resetBtn();
    });
  }

  function loadMyAds() {
    if (!partnerToken) { renderMyAds(); return; }
    fetch(API_BASE + '/api/ads/mine', { headers: { 'Authorization': 'Bearer ' + partnerToken } })
      .then(function(r){ return r.json(); })
      .then(function(d){ myAds = (d && d.ads) || []; renderMyAds(); })
      .catch(function(){ renderMyAds(); });
  }

  function deleteAd(adId) {
    var t = T[currentLang] || {};
    if (!confirm(t.confirmDeleteAd || 'TÃ« fshihet kjo reklamÃ«?')) return;
    fetch(API_BASE + '/api/ads/delete', {
      method: 'POST',
      headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + partnerToken},
      body: JSON.stringify({ adId: adId })
    })
    .then(function(r){ return r.json(); })
    .then(function(){ loadMyAds(); })
    .catch(function(){});
  }

  function renderMyAds() {
    var t = T[currentLang] || {};
    var list = document.getElementById('myAdsList');
    if (!list) return;
    if (!myAds.length) {
      list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">' + (t.noAds || 'Nuk ka reklama ende. Krijoni reklamÃ«n tuaj tÃ« parÃ«!') + '</p>';
      return;
    }
    var catLabels = {food: 'Ushqim', bakery: 'BukÃ«', produce: 'Fruta', meat: 'Mish', dairy: 'Bulmet', other: 'TÃ« tjera'};
    list.innerHTML = myAds.map(function(ad) {
      var when = ad.createdAt ? String(ad.createdAt).split('T')[0] : '';
      var priceHtml = (ad.price != null && ad.price !== '') ? ('<span style="font-size:0.8rem;font-weight:700;color:var(--primary)">' + escapeHtml(String(ad.price)) + ' LEK</span>') : '';
      return '<div class="ad-card" style="border:1px solid #F5C518;background:#FFFDF5;border-radius:10px;padding:12px;margin-bottom:8px">' +
        '<div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;gap:8px">' +
          '<strong style="font-size:0.9rem">â­ ' + escapeHtml(ad.title) + '</strong>' +
          priceHtml +
        '</div>' +
        '<div style="font-size:0.8rem;color:var(--gray-500);margin-bottom:6px">' + escapeHtml(ad.description || '') + '</div>' +
        '<div style="display:flex;justify-content:space-between;align-items:center">' +
          '<span style="font-size:0.7rem;background:var(--gray-100);padding:2px 8px;border-radius:8px">' + (catLabels[ad.category] || ad.category || '') + '</span>' +
          '<span style="font-size:0.7rem;color:var(--gray-400)">' + when + '</span>' +
        '</div>' +
        '<button onclick="deleteAd(\'' + ad.id + '\')" style="margin-top:8px;width:100%;padding:6px;border:1px solid var(--gray-200);background:#fff;border-radius:8px;font-size:0.75rem;color:var(--danger);cursor:pointer">' + (t.btnDelete || 'Hiq reklamÃ«n') + '</button>' +
      '</div>';
    }).join('');
  }

  // ========================================
  // INVOICE
  // ========================================
  function addItem() {
    var tbody = document.getElementById('itemsBody');
    var row = document.createElement('tr');
    row.className = 'item-row';
    row.innerHTML = '<td><input type="text" class="item-code" placeholder="A001" value=""></td>' +
      '<td><input type="text" class="item-desc" placeholder="Pershkrimi"></td>' +
      '<td><input type="text" class="item-unit" value="cope"></td>' +
      '<td><input type="number" class="item-qty" value="1" min="0" step="0.01"></td>' +
      '<td><input type="number" class="item-price" value="0" min="0" step="0.01"></td>' +
      '<td><input type="number" class="item-vat-rate" value="20" min="0" max="100"></td>' +
      '<td><input type="text" class="item-total" readonly value="0.00" style="background:var(--gray-50)"></td>' +
      '<td><button type="button" class="btn-icon" onclick="removeItem(this)">x</button></td>';
    tbody.appendChild(row);
    attachCalcListeners(row);
  }

  function removeItem(btn) {
    var rows = document.querySelectorAll('.item-row');
    if (rows.length <= 1) return;
    btn.closest('tr').remove();
    calculateTotals();
  }

  function attachCalcListeners(row) {
    row.querySelectorAll('.item-qty, .item-price, .item-vat-rate').forEach(function(el) {
      el.addEventListener('input', function() {
        var r = this.closest('tr');
        var qty = parseFloat(r.querySelector('.item-qty').value) || 0;
        var price = parseFloat(r.querySelector('.item-price').value) || 0;
        r.querySelector('.item-total').value = (qty * price).toFixed(2);
        calculateTotals();
      });
    });
  }

  function calculateTotals() {
    var sub = 0, vat = 0;
    document.querySelectorAll('.item-row').forEach(function(r) {
      var qty = parseFloat(r.querySelector('.item-qty').value) || 0;
      var price = parseFloat(r.querySelector('.item-price').value) || 0;
      var rate = parseFloat(r.querySelector('.item-vat-rate').value) || 0;
      var line = qty * price;
      sub += line;
      vat += line * (rate / 100);
    });
    document.getElementById('subTotal').textContent = sub.toFixed(2);
    document.getElementById('vatAmount').textContent = vat.toFixed(2);
    document.getElementById('grandTotal').textContent = (sub + vat).toFixed(2);
  }

  document.querySelectorAll('.item-row').forEach(attachCalcListeners);

  function resetInvoice() {
    document.getElementById('buyerName').value = '';
    document.getElementById('buyerNipt').value = '';
    document.getElementById('buyerAddress').value = '';
    document.getElementById('buyerPhone').value = '';
    document.getElementById('buyerEmail').value = '';
    document.getElementById('paymentDue').value = '';
    document.getElementById('itemsBody').innerHTML = '<tr class="item-row">' +
      '<td><input type="text" class="item-code" placeholder="A001" value=""></td>' +
      '<td><input type="text" class="item-desc" placeholder="Pershkrimi"></td>' +
      '<td><input type="text" class="item-unit" value="cope"></td>' +
      '<td><input type="number" class="item-qty" value="1" min="0" step="0.01"></td>' +
      '<td><input type="number" class="item-price" value="0" min="0" step="0.01"></td>' +
      '<td><input type="number" class="item-vat-rate" value="20" min="0" max="100"></td>' +
      '<td><input type="text" class="item-total" readonly value="0.00" style="background:var(--gray-50)"></td>' +
      '<td><button type="button" class="btn-icon" onclick="removeItem(this)">x</button></td></tr>';
    calculateTotals();
    document.querySelectorAll('.item-row').forEach(attachCalcListeners);
  }

  function saveInvoice() {
    var t = T[currentLang];
    if (!document.getElementById('buyerName').value.trim()) {
      document.getElementById('invoiceError').innerHTML = '<div class="error-msg">' + t.buyerRequired + '</div>';
      return;
    }
    var items = [];
    document.querySelectorAll('.item-row').forEach(function(r) {
      var desc = r.querySelector('.item-desc').value;
      var qty = parseFloat(r.querySelector('.item-qty').value) || 0;
      var price = parseFloat(r.querySelector('.item-price').value) || 0;
      if (desc && qty > 0) items.push({code: r.querySelector('.item-code').value, desc: desc, unit: r.querySelector('.item-unit').value, qty: qty, price: price, vatRate: parseFloat(r.querySelector('.item-vat-rate').value) || 0});
    });
    if (items.length === 0) { document.getElementById('invoiceError').innerHTML = '<div class="error-msg">' + t.itemRequired + '</div>'; return; }

    var sub = parseFloat(document.getElementById('subTotal').textContent) || 0;
    var vat = parseFloat(document.getElementById('vatAmount').textContent) || 0;

    // Save invoice to localStorage (backend has no invoice endpoint)
    var invoiceData = {
      id: 'inv_' + Date.now(),
      items: items, clientName: document.getElementById('buyerName').value,
      clientNipt: document.getElementById('buyerNipt').value,
      clientAddress: document.getElementById('buyerAddress').value,
      clientPhone: document.getElementById('buyerPhone').value,
      subtotal: sub, vat: vat, total: sub + vat,
      currency: document.getElementById('currency').value,
      createdAt: new Date().toISOString()
    };
    var invoices = JSON.parse(localStorage.getItem('savora_invoices') || '[]');
    invoices.push(invoiceData);
    localStorage.setItem('savora_invoices', JSON.stringify(invoices));

    document.getElementById('invoiceError').innerHTML = '';
    document.getElementById('invoiceSuccess').innerHTML = '<div class="success-msg">' + escapeHtml(t.invoiceSaved || 'Invoice saved!') + ' ID: ' + escapeHtml(invoiceData.id) + '</div>';
    resetInvoice();
    loadStats();
  }

  function previewInvoice() {
    var t = T[currentLang];
    var pm = document.getElementById('paymentMethod');
    var payMethod = pm.options[pm.selectedIndex].text;
    var cur = document.getElementById('currency').value;

    var itemsHtml = '';
    document.querySelectorAll('.item-row').forEach(function(r, i) {
      var desc = escapeHtml(r.querySelector('.item-desc').value) || (t.invoiceItem || 'Item');
      var qty = parseFloat(r.querySelector('.item-qty').value) || 0;
      var price = parseFloat(r.querySelector('.item-price').value) || 0;
      var rate = parseFloat(r.querySelector('.item-vat-rate').value) || 0;
      var total = (qty * price).toFixed(2);
      var code = escapeHtml(r.querySelector('.item-code').value || '');
      var unit = escapeHtml(r.querySelector('.item-unit').value || '');
      if (desc) itemsHtml += '<tr><td>'+(i+1)+'</td><td>'+code+'</td><td>'+desc+'</td><td>'+unit+'</td><td>'+qty+'</td><td>'+price.toFixed(2)+'</td><td>'+rate+'%</td><td>'+total+'</td></tr>';
    });

    var sub = parseFloat(document.getElementById('subTotal').textContent) || 0;
    var vat = parseFloat(document.getElementById('vatAmount').textContent) || 0;
    var grand = parseFloat(document.getElementById('grandTotal').textContent) || 0;
    var now = new Date();

    document.getElementById('printBody').innerHTML =
      '<div style="text-align:center;margin-bottom:20px">' +
      '<h1 style="font-size:1.5rem;color:var(--primary)">' + (t.invoiceTitle || 'INVOICE') + '</h1>' +
      '<p>' + (t.serialLabel || 'No:') + ' INV-' + now.getFullYear() + '-' + String(now.getMonth()+1).padStart(2,'0') + '-' + String(Math.floor(Math.random()*10000)).padStart(4,'0') + '</p>' +
      '<p>' + (t.dateLabel || 'Date:') + ' ' + now.toLocaleDateString() + '</p></div>' +
      '<div style="display:flex;justify-content:space-between;margin-bottom:20px;font-size:0.85rem">' +
      '<div><strong>' + (t.sellerLabel || 'SELLER') + '</strong><br>William Al Farhat<br>NUI: M51921505O<br>IBAN: AL57902127674521230229786655<br>' + (t.bankLabel || 'Bank:') + ' OTP Bank Albania</div>' +
      '<div style="text-align:right"><strong>' + (t.buyerLabel || 'BUYER') + '</strong><br>' + (document.getElementById('buyerName').value || '-') + '<br>NIPT: ' + (document.getElementById('buyerNipt').value || '-') + '<br>' + (document.getElementById('buyerAddress').value || '') + '<br>' + (document.getElementById('buyerPhone').value || '') + '</div></div>' +
      '<table style="width:100%;border-collapse:collapse;font-size:0.85rem;margin-bottom:20px"><thead><tr style="background:#f3f4f6">' +
      '<th style="border:1px solid #ddd;padding:8px">#</th><th style="border:1px solid #ddd;padding:8px">' + (t.colCode || 'Code') + '</th><th style="border:1px solid #ddd;padding:8px">' + (t.colDesc || 'Desc') + '</th><th style="border:1px solid #ddd;padding:8px">' + (t.colUnit || 'Unit') + '</th><th style="border:1px solid #ddd;padding:8px">' + (t.colQty || 'Qty') + '</th><th style="border:1px solid #ddd;padding:8px">' + (t.colPrice || 'Price') + '</th><th style="border:1px solid #ddd;padding:8px">VAT%</th><th style="border:1px solid #ddd;padding:8px">Total</th></tr></thead><tbody>' + itemsHtml + '</tbody></table>' +
      '<div style="text-align:right;font-size:0.9rem">' +
      '<p>' + (t.totalExcl || 'Subtotal:') + ' ' + sub.toFixed(2) + ' ' + cur + '</p>' +
      '<p>' + (t.vatLabel || 'VAT:') + ' ' + vat.toFixed(2) + ' ' + cur + '</p>' +
      '<p style="font-size:1.2rem;font-weight:700;color:var(--primary)">' + (t.totalGrand || 'TOTAL') + ': ' + grand.toFixed(2) + ' ' + cur + '</p>' +
      '<p style="font-size:0.8rem;color:var(--gray-500);margin-top:8px">' + (t.paymentMethodLabel || 'Payment:') + ' ' + payMethod + '</p></div>' +
      '<div style="margin-top:30px;padding-top:16px;border-top:2px solid var(--primary);font-size:0.75rem;color:var(--gray-500);text-align:center">' +
      '<p>' + (t.footerNote || 'Generated by Savoraapp') + '</p></div>';

    document.getElementById('printModal').classList.add('show');
  }

  function closePrint() { document.getElementById('printModal').classList.remove('show'); }

  // ========================================
  // PAYMENT MODAL
  // ========================================
  function openPayment(pkgId, amount) {
    document.getElementById('paymentAmount').textContent = amount.toLocaleString() + ' LEK';
    document.getElementById('paymentAmount2').textContent = amount.toLocaleString() + ' LEK';
    if (partnerInfo) document.getElementById('payBusinessName').value = partnerInfo.business || '';
    document.getElementById('paymentModal').classList.add('show');
  }
  function closePayment() { document.getElementById('paymentModal').classList.remove('show'); }

  // ===== BUY CREDITS (Paysera + Direct) =====
  var currentPollingInterval = null;

  async function buyCredits(packageId, amountLEK) {
    var t = T[currentLang];
    var packageMap = {
      1: 'basic', 2: 'standard', 3: 'premium',
      'basic': 'basic', 'standard': 'standard', 'premium': 'premium'
    };
    var packageKey = packageMap[packageId] || 'basic';

    var partnerId = partnerInfo ? (partnerInfo.id || partnerInfo.email) : null;
    if (!partnerId) {
      alert('âŒ Ju lutem identifikohuni fillimest / Please login first');
      return;
    }

    try {
      var res = await fetch(API_BASE + '/api/credits/purchase', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + partnerToken},
        body: JSON.stringify({package: packageKey, paymentRef: 'manual_payment'})
      });
      var data = await res.json();
      if (data.success) {
        loadCreditsFromAPI(partnerId);
        alert('âœ… ' + (t.creditsAdded || 'Credits toegevoegd!') + ' +' + (data.package ? data.package.credits : '') + ' kredite.');
      } else {
        alert('âŒ ' + (data.error || 'Gabim'));
      }
    } catch(err) {
      console.error('Buy credits error:', err);
      alert('âŒ ' + (t.loginError || 'Verbindingsfout'));
    }
  }

  // ===== Betaalmethode-keuze (Paysera / bank) =====
  var _payPkg = { id: 'basic', amt: 500 };
  function choosePayment(packageId, amountLEK) {
    _payPkg = { id: packageId, amt: amountLEK };
    var m = document.getElementById('payMethodModal');
    var amtEl = document.getElementById('payMethodAmount');
    if (amtEl) amtEl.textContent = amountLEK + ' LEK';
    if (m) m.style.display = 'flex';
  }
  function closePayMethod() {
    var m = document.getElementById('payMethodModal');
    if (m) m.style.display = 'none';
  }
  function _getPromo() {
    var el = document.getElementById('promoInput');
    return el && el.value ? el.value.trim().toUpperCase() : null;
  }
  async function applyPromoCode() {
    var code = _getPromo();
    var msg = document.getElementById('promoMsg');
    if (!code) { if (msg) msg.style.display = 'none'; return; }
    try {
      var res = await fetch(API_BASE + '/api/promo/validate', {
        method: 'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer ' + partnerToken},
        body: JSON.stringify({ code: code })
      });
      var data = await res.json();
      if (msg) {
        msg.style.display = 'block';
        if (data.valid) { msg.style.color = '#16a34a'; msg.textContent = (currentLang === 'en' ? 'Code valid: -' : 'Kod i vlefshÃ«m: -') + data.percent + '%'; }
        else { msg.style.color = '#dc2626'; msg.textContent = (currentLang === 'en' ? 'Invalid code' : 'Kod i pavlefshÃ«m'); }
      }
    } catch (e) {
      if (msg) { msg.style.display = 'block'; msg.style.color = '#dc2626'; msg.textContent = 'Error: ' + e.message; }
    }
  }
  function payWith(method) {
    closePayMethod();
    if (method === 'paysera') buyCreditsViaPaysera(_payPkg.id, _payPkg.amt);
    else if (method === 'pok') buyCreditsViaPok(_payPkg.id, _payPkg.amt);
    else if (method === 'paypal') buyCreditsViaPaypal(_payPkg.id);
    else if (method === 'bank') showBankTransfer(_payPkg.id, _payPkg.amt);
  }
  async function buyCreditsViaPaypal(packageId) {
    var partnerId = partnerInfo ? (partnerInfo.id || partnerInfo.email) : null;
    if (!partnerId) {
      alert('âŒ Ju lutem identifikohuni fillimisht / Please login first');
      return;
    }
    var packageMap = { 1:'basic',2:'standard',3:'premium','basic':'basic','standard':'standard','premium':'premium' };
    var packageKey = packageMap[packageId] || 'basic';
    try {
      var res = await fetch(API_BASE + '/api/paypal/create-order', {
        method: 'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer ' + partnerToken},
        body: JSON.stringify({ package: packageKey, discountCode: _getPromo() })
      });
      var data = await res.json();
      if (data.success && data.url) {
        try { localStorage.setItem('savora_paypal_order', data.orderId); } catch(e){}
        window.location.href = data.url;
      } else {
        alert('âŒ ' + (data.error || 'PayPal pagesa dÃ«shtoi / PayPal payment failed'));
      }
    } catch (e) {
      alert('âŒ Gabim rrjeti / Network error: ' + e.message);
    }
  }
  async function handlePokReturn() {
    try {
      var qs = new URLSearchParams(window.location.search);
      if (qs.get('payment') === 'cancel') {
        window.history.replaceState({}, '', '/partner-dashboard');
        return;
      }
      if (qs.get('payment') !== 'success') return;
      var ref = qs.get('ref');
      window.history.replaceState({}, '', '/partner-dashboard');
      if (!ref || !partnerToken) return;
      var res = await fetch(API_BASE + '/api/pok/verify', {
        method: 'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer ' + partnerToken},
        body: JSON.stringify({ ref: ref })
      });
      var data = await res.json();
      if (data.success) {
        alert('âœ… Pagesa u krye me sukses!' + (data.credits != null ? (' ' + data.credits + ' kredite u shtuan.') : ''));
        location.reload();
      } else {
        alert('â„¹ï¸ ' + (data.error || 'Pagesa nuk u konfirmua ende.'));
      }
    } catch (e) {
      console.error('[POK] return fout:', e && e.message);
    }
  }
  async function handlePaypalReturn() {
    try {
      var qs = new URLSearchParams(window.location.search);
      if (qs.get('paypal_cancel') === '1') {
        try { localStorage.removeItem('savora_paypal_order'); } catch(e){}
        window.history.replaceState({}, '', '/partner-dashboard');
        return;
      }
      if (qs.get('paypal_return') !== '1') return;
      var orderId = qs.get('token') || localStorage.getItem('savora_paypal_order');
      window.history.replaceState({}, '', '/partner-dashboard');
      if (!orderId || !partnerToken) return;
      var res = await fetch(API_BASE + '/api/paypal/capture', {
        method: 'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer ' + partnerToken},
        body: JSON.stringify({ orderId: orderId })
      });
      var data = await res.json();
      try { localStorage.removeItem('savora_paypal_order'); } catch(e){}
      if (data.success) {
        alert('âœ… Pagesa u krye me sukses!' + (data.credits != null ? (' ' + data.credits + ' kredite u shtuan.') : ''));
        location.reload();
      } else {
        alert('âŒ ' + (data.error || 'PayPal capture failed'));
      }
    } catch (e) {
      console.error('[PAYPAL] return fout:', e && e.message);
    }
  }
  async function buyCreditsViaPok(packageId, amountLEK) {
    var partnerId = partnerInfo ? (partnerInfo.id || partnerInfo.email) : null;
    if (!partnerId) {
      alert('âŒ Ju lutem identifikohuni fillimisht / Please login first');
      return;
    }
    var packageMap = { 1:'basic',2:'standard',3:'premium','basic':'basic','standard':'standard','premium':'premium' };
    var packageKey = packageMap[packageId] || 'basic';
    try {
      var res = await fetch(API_BASE + '/api/pok/create-payment', {
        method: 'POST',
        headers: {'Content-Type':'application/json','Authorization':'Bearer ' + partnerToken},
        body: JSON.stringify({ package: packageKey, discountCode: _getPromo() })
      });
      var data = await res.json();
      if (data.success && data.url) {
        window.location.href = data.url;
      } else {
        alert('âŒ ' + (data.error || 'POK pagesa dÃ«shtoi / POK payment failed'));
      }
    } catch (e) {
      alert('âŒ Gabim rrjeti / Network error: ' + e.message);
    }
  }
  function showBankTransfer(packageId, amountLEK) {
    var packageMap = { 1:'basic',2:'standard',3:'premium','basic':'basic','standard':'standard','premium':'premium' };
    var orderId = 'credit_' + (packageMap[packageId]||'basic') + '_' + Date.now();
    alert('ðŸ¦ TransfertÃ« Bankare\n\nIBAN: AL57902127674521230229786655\nNÃ« emÃ«r tÃ«: William Al Farhat\nReferenca: ' + orderId + '\nShuma: ' + amountLEK + ' LEK\n\nKreditet shtohen brenda 1 dite pune pas pagesÃ«s.');
  }

  async function buyCreditsViaPaysera(packageId, amountLEK) {
    var t = T[currentLang];
    var partnerId = partnerInfo ? (partnerInfo.id || partnerInfo.email) : null;
    if (!partnerId) {
      alert('âŒ Ju lutem identifikohuni fillimest / Please login first');
      return;
    }

    var packageMap = {
      1: 'basic', 2: 'standard', 3: 'premium',
      'basic': 'basic', 'standard': 'standard', 'premium': 'premium'
    };
    var creditsMap = {1: 20, 2: 50, 3: 120, 'basic': 20, 'standard': 50, 'premium': 120};
    var packageKey = packageMap[packageId] || 'basic';
    var credits = creditsMap[packageId] || 20;
    var orderId = 'credit_' + packageKey + '_' + Date.now();

    try {
      var res = await fetch(API_BASE + '/api/paysera/create-payment', {
        method: 'POST',
        headers: {'Content-Type': 'application/json', 'Authorization': 'Bearer ' + partnerToken},
        body: JSON.stringify({
          partnerId: partnerId,
          package: packageKey,
          discountCode: _getPromo(),
          amount: amountLEK,
          orderId: orderId,
          currency: 'EUR'
        })
      });
      var data = await res.json();

      if (data.success && data.url) {
        var choice = confirm(
          'Pako ' + packageKey + ' - ' + credits + ' kredite\n' +
          'Bedrag: ' + amountLEK + ' LEK\n\n' +
          'Kies uw betaalmethode:\n' +
          'â€¢ OK = Betaal online via Paysera (direct)\n' +
          'â€¢ Annuleer = Bankoverschrijving (1 werkdag)'
        );

        if (choice) {
          window.open(data.url, '_blank');
        } else {
          alert(
            'ðŸ¦ Bankoverschrijving\n\n' +
            'IBAN: AL57902127674521230229786655\n' +
            'Ten name van: William Al Farhat (savoraapp.com)\n' +
            'Referentie: ' + orderId + '\n' +
            'Bedrag: ' + amountLEK + ' LEK\n\n' +
            'Na betaling worden de credits binnen 1 werkdag toegevoegd.'
          );
        }

        // Poll for payment confirmation
        if (currentPollingInterval) clearInterval(currentPollingInterval);
        var oldCredits = parseInt((document.getElementById('creditBalance')?.textContent || '0').replace(/\D/g, ''), 10) || 0;
        var pollCount = 0;
        currentPollingInterval = setInterval(async function() {
          pollCount++;
          if (pollCount > 60) { clearInterval(currentPollingInterval); currentPollingInterval = null; return; }
          try {
            var checkRes = await fetch(API_BASE + '/api/credits/' + partnerId, {
              headers: {'Authorization': 'Bearer ' + partnerToken}
            });
            var checkData = await checkRes.json();
            if (checkData.success && checkData.credits > oldCredits) {
              clearInterval(currentPollingInterval);
              currentPollingInterval = null;
              loadCreditsFromAPI(partnerId);
              alert('âœ… Betaling geslaagd! +' + checkData.credits + ' credits toegevoegd.');
            }
          } catch(e) {}
        }, 5000);

      } else {
        alert('âŒ ' + (data.error || 'Kon betaalpagina niet aanmaken'));
      }
    } catch(err) {
      console.error('Paysera error:', err);
      alert('âŒ Betaling mislukt. Probeer het later opnieuw.');
    }
  }

  function loadCreditsFromAPI(partnerId) {
    if (!partnerId) return;
    fetch(API_BASE + '/api/credits/' + encodeURIComponent(partnerId), {
      headers: {'Authorization': 'Bearer ' + partnerToken}
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      var balance = data.credits || 0;
      // Welkomstcadeau-melding boven de credits-kaart (zolang beschikbaar)
      var wgHost = document.getElementById('creditCard');
      var wgBanner = document.getElementById('welcomeGiftBanner');
      if (data.welcomeBonusRemaining > 0 && wgHost) {
        if (!wgBanner) {
          wgBanner = document.createElement('div');
          wgBanner.id = 'welcomeGiftBanner';
          wgBanner.style.cssText = 'background:linear-gradient(135deg,#f0fdf4,#dcfce7);border:2px solid #16a34a;border-radius:14px;padding:16px 20px;margin-bottom:16px;color:#166534;font-weight:600;font-size:0.95rem;display:flex;align-items:center;gap:12px';
          wgHost.parentNode.insertBefore(wgBanner, wgHost);
        }
        wgBanner.innerHTML = 'ðŸŽ <span>' + (currentLang === 'en'
          ? 'Welcome bonus: you have <strong>' + data.welcomeBonusRemaining + ' free credits</strong>!'
          : 'Bonus mirÃ«seardhjeje: keni <strong>' + data.welcomeBonusRemaining + ' kredite falas</strong>!') + '</span>';
      } else if (wgBanner) {
        wgBanner.remove();
      }
      var history = data.transactions || data.history || [];

      document.getElementById('creditBalance').textContent = balance.toLocaleString();
      if (typeof syncFormBalance === 'function') syncFormBalance();
      document.getElementById('creditMonthly').textContent = '1 kredit = 1 postim';
      var postimeText = {
        sq: 'postime tÃ« mbetura', en: 'posts remaining', nl: 'posts resterend',
        de: 'BeitrÃ¤ge verbleibend', it: 'post rimanenti', gr: 'Ï…Ï€Î¿Î»ÎµÎ¹Ï€ÏŒÎ¼ÎµÎ½ÎµÏ‚ Î´Î·Î¼Î¿ÏƒÎ¹ÎµÏÏƒÎµÎ¹Ï‚',
        fr: 'publications restantes', es: 'publicaciones restantes', tr: 'kalan gÃ¶nderi', ar: 'Ù…Ù†Ø´ÙˆØ±Ø§Øª Ù…ØªØ¨Ù‚ÙŠØ©'
      };
      document.getElementById('creditUsed').textContent = balance + ' ' + (postimeText[currentLang] || postimeText['sq']);

      var bar = document.getElementById('creditProgressBar');
      bar.style.width = balance > 0 ? '100%' : '0%';
      bar.className = 'credit-progress-bar';
      if (balance > 10) bar.classList.add('green');
      else if (balance > 0) bar.classList.add('yellow');
      else bar.classList.add('red');

      // Render history
      var tbody = document.getElementById('historyTableBody');
      if (history.length > 0) {
        var txLabels = {
          daily_deal: {sq:'OfertÃ« ditore', en:'Daily deal', nl:'Dagaanbieding', de:'Tagesangebot', it:'Offerta del giorno', gr:'Kathimerini prosfora', fr:'Offre du jour', es:'Oferta del dÃ­a', tr:'GÃ¼nlÃ¼k fÄ±rsat', ar:'Daily deal'},
          premium_ad: {sq:'ReklamÃ« premium', en:'Premium ad', nl:'Premium advertentie', de:'Premium-Anzeige', it:'Annuncio premium', gr:'Premium diafimisi', fr:'Annonce premium', es:'Anuncio premium', tr:'Premium reklam', ar:'Premium ad'},
          advertentie: {sq:'ReklamÃ«', en:'Ad', nl:'Advertentie', de:'Anzeige', it:'Annuncio', gr:'Diafimisi', fr:'Annonce', es:'Anuncio', tr:'Reklam', ar:'Ad'},
          purchase: {sq:'Blerje kreditesh', en:'Credit purchase', nl:'Credits gekocht', de:'Credit-Kauf', it:'Acquisto crediti', gr:'Agora credits', fr:'Achat de crÃ©dits', es:'Compra de crÃ©ditos', tr:'Kredi alÄ±mÄ±', ar:'Credit purchase'},
          admin_adjustment: {sq:'Rregullim krediti', en:'Adjustment', nl:'Aanpassing', de:'Anpassung', it:'Rettifica', gr:'Prosarmogi', fr:'Ajustement', es:'Ajuste', tr:'DÃ¼zeltme', ar:'Adjustment'}
        };
        tbody.innerHTML = history.map(function(tx) {
          var amt = (typeof tx.amount === 'number') ? tx.amount
                  : (typeof tx.credits === 'number') ? tx.credits
                  : -(tx.creditsUsed || 0);
          var amtClass = amt >= 0 ? 'amount-positive' : 'amount-negative';
          var sign = amt > 0 ? '+' : '';
          var typ = tx.adType || tx.type || '';
          var lbl = (txLabels[typ] && (txLabels[typ][currentLang] || txLabels[typ].en)) || tx.description || tx.reason || typ || '';
          var ts = tx.postedAt || tx.date || tx.purchasedAt;
          var date = '';
          try { date = ts ? new Date(ts).toISOString().split('T')[0] : ''; } catch(e){ date = String(ts || ''); }
          return '<tr><td>' + date + '</td><td><div>' + escapeHtml(lbl) + '</div></td><td class="' + amtClass + '">' + sign + amt + '</td><td>' + balance.toLocaleString() + '</td></tr>';
        }).join('');
      } else {
        tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--gray-400);padding:20px">' + (T[currentLang].noHistory || 'Nuk ka transaksione') + '</td></tr>';
      }
    })
    .catch(function(err){
      console.error('Load credits error:', err);
    });
  }

  function copyIban() {
    var iban = 'AL57902127674521230229786655';
    var btn = document.querySelector('.payment-body button[onclick*="copyIban"]') || document.activeElement;
    var orig = btn ? btn.innerHTML : 'Kopjo IBAN';
    navigator.clipboard.writeText(iban).then(function() {
      if (btn) { btn.innerHTML = ' IBAN copied!'; btn.style.background = 'var(--success)'; }
      setTimeout(function(){ if (btn) { btn.innerHTML = orig; btn.style.background = ''; } }, 2500);
    }).catch(function(){
      var ta = document.createElement('textarea'); ta.value = iban; document.body.appendChild(ta); ta.select();
      document.execCommand('copy'); document.body.removeChild(ta);
      if (btn) { btn.innerHTML = ' IBAN copied!'; btn.style.background = 'var(--success)'; }
      setTimeout(function(){ if (btn) { btn.innerHTML = orig; btn.style.background = ''; } }, 2500);
    });
  }

  // ========================================
  // DATA LOADING
  // ========================================
  function loadStats() {
    var invoices = JSON.parse(localStorage.getItem('savora_invoices') || '[]');
    document.getElementById('totalInvoices').textContent = invoices.length;
    var total = invoices.reduce(function(s, inv) { return s + (inv.total || 0); }, 0);
    document.getElementById('totalValue').textContent = total.toFixed(2) + ' LEK';
  }

  function loadInvoices() {
    var t = T[currentLang];
    var list = document.getElementById('invoicesList');
    var invoices = JSON.parse(localStorage.getItem('savora_invoices') || '[]');
    if (invoices.length > 0) {
      list.innerHTML = invoices.slice().reverse().map(function(inv) {
        var d = new Date(inv.createdAt);
        return '<div class="invoice-row"><div class="inv-info"><div class="inv-client">' + escapeHtml(inv.clientName || '-') + '</div><div class="inv-date">' + d.toLocaleDateString() + '</div></div><div class="inv-amount">' + (inv.total || 0).toFixed(2) + ' ' + escapeHtml(inv.currency || 'LEK') + '</div></div>';
      }).join('');
    } else {
      list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:40px">' + (t.noInvoices || 'No invoices yet') + '</p>';
    }
  }

  // ========================================
  // INIT
  // ========================================
  async function init() {
    console.log('[INIT] Starting...');
    try {

    // Set language
    try {
      var savedLang = localStorage.getItem('partnerLang') || 'sq';
      setLang(savedLang);
    } catch(e) { console.warn('[INIT] setLang error:', e); }

    // Check for reset token in URL
    var urlParams = new URLSearchParams(window.location.search);
    var resetToken = urlParams.get('reset');
    if (!resetToken && window.location.hash && window.location.hash.indexOf('reset=') > -1) {
      resetToken = window.location.hash.replace('#reset=', '').replace('#', '');
    }
    if (resetToken) {
      document.getElementById('resetToken').value = resetToken;
      showResetPassword();
      return;
    }

    // Check for ?tab=register in URL
    var tabParam = urlParams.get('tab');

    // === CHECK: bestaand JWT token (met timeout) ===
    var savedToken = localStorage.getItem('partnerToken') || '';
    if (savedToken) {
      console.log('[INIT] Token gevonden, check sessie...');
      try {
        var controller = new AbortController();
        var timeoutId = setTimeout(function() { controller.abort(); }, 3000); // 3 sec timeout
        var res = await fetch(API_BASE + '/api/partner/session', {
          headers: {'Authorization': 'Bearer ' + savedToken},
          signal: controller.signal
        });
        clearTimeout(timeoutId);
        if (res.ok) {
          var data = await res.json();
          if (data.success) {
            partnerToken = savedToken;
            partnerInfo = { name: data.name, business: data.business, email: data.email };
            console.log('[INIT] Sessie OK, toon dashboard');
            showDashboard();
            handlePaypalReturn();
            handlePokReturn();
            return;
          }
        }
      } catch(e) {
        console.warn('[INIT] Session check failed:', e.message || e);
      }
      // Token ongeldig, wis uit localStorage
      localStorage.removeItem('partnerToken');
      partnerToken = '';
    }

    // Geen geldig token â†’ toon login
    console.log('[INIT] Toon login scherm');
    showLoginScreen();

    // Als ?tab=register, toon register tab
    if (tabParam === 'register') {
      console.log('[INIT] Register tab actief');
      switchAuthTab('register');
    }

    // Enter key listener op verificatie input
    var verifyInput = document.getElementById('verifyCodeInput');
    if (verifyInput) {
      verifyInput.addEventListener('keypress', function(e) {
        if (e.key === 'Enter') verifyRegistrationCode();
      });
    }

    } catch(initErr) {
      console.error('[INIT] CRITICAL ERROR:', initErr);
      // Altijd login tonen als er iets misgaat
      showLoginScreen();
    }
  }

  function showVerificationScreen(partnerId) {
    // Verberg alle auth form secties
    ['loginFormSection', 'forgotPwSection', 'resetPwSection', 'registerFormSection'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.classList.remove('active');
    });
    // Toon verificatie sectie
    var verifySection = document.getElementById('verifyCodeSection');
    if (verifySection) {
      verifySection.classList.remove('hidden');
      verifySection.style.display = 'block';
    }
    // Toon email adres
    var emailDisplay = document.getElementById('verifyEmailDisplay');
    var partnerEmail = localStorage.getItem('savora_partner_email');
    if (emailDisplay && partnerEmail) {
      emailDisplay.textContent = partnerEmail;
    }
    // Reset input en errors
    var input = document.getElementById('verifyCodeInput');
    if (input) input.value = '';
    var errDiv = document.getElementById('verifyCodeError');
    if (errDiv) { errDiv.classList.add('hidden'); errDiv.textContent = ''; }
    var succDiv = document.getElementById('verifyCodeSuccess');
    if (succDiv) succDiv.innerHTML = '';
    // Focus op input
    setTimeout(function() {
      if (input) input.focus();
    }, 100);
    console.log('[VERIFY] Showing verification screen for partner:', partnerId);
  }

  function showLoginScreen() {
    document.getElementById('loginScreen').classList.remove('hidden');
    document.getElementById('loginScreen').style.display = '';
    document.getElementById('pricingScreen').style.display = 'none';
    document.getElementById('dashboard').style.display = 'none';
    // Verberg verify sectie als die zichtbaar is
    var verifySection = document.getElementById('verifyCodeSection');
    if (verifySection) {
      verifySection.classList.add('hidden');
      verifySection.style.display = 'none';
    }
    showLogin();
  }

  // Payment due date default
  try {
    var pd = new Date(); pd.setDate(pd.getDate() + 30);
    var paymentDueEl = document.getElementById('paymentDue');
    if (paymentDueEl) paymentDueEl.value = pd.toISOString().split('T')[0];
  } catch(e) { /* ignore */ }

  // ===== HELPER FUNCTIES =====
  function showError(elementId, message) {
    var el = document.getElementById(elementId);
    if (el) {
      el.innerHTML = '<div class="error-msg">' + message + '</div>';
      el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }
  }
  function showSuccessMsg(elementId, message) {
    var el = document.getElementById(elementId);
    if (el) el.innerHTML = '<div class="success-msg">' + message + '</div>';
  }
  function clearError(elementId) {
    var el = document.getElementById(elementId);
    if (el) el.innerHTML = '';
  }
  function validateNui(value) {
    if (!value || value.length !== 10) return false;
    return /^[A-Z]\d{8}[A-Z]$/.test(value.toUpperCase());
  }

  // ===== TOAST NOTIFICATIES =====
  function showToast(msg, type) {
    type = type || 'info';
    var colors = { success: '#10b981', error: '#ef4444', info: 'var(--primary)', warning: '#f59e0b' };
    var t = document.createElement('div');
    t.style.cssText = 'position:fixed;bottom:24px;left:50%;transform:translateX(-50%) scale(0.95);background:' + (colors[type] || colors.info) + ';color:#fff;padding:12px 24px;border-radius:12px;font-size:0.9rem;font-weight:600;box-shadow:0 8px 24px rgba(0,0,0,0.2);z-index:9999;opacity:0;transition:all 0.3s;white-space:nowrap;pointer-events:none;';
    t.textContent = msg;
    document.body.appendChild(t);
    requestAnimationFrame(function() { t.style.opacity = '1'; t.style.transform = 'translateX(-50%) scale(1)'; });
    setTimeout(function() {
      t.style.opacity = '0'; t.style.transform = 'translateX(-50%) scale(0.95)';
      setTimeout(function() { if(t.parentNode) t.remove(); }, 300);
    }, 3500);
  }

  // Maak handlers bereikbaar voor de inline onclick/onchange in de HTML
  // (deze functies staan binnen de IIFE en zijn anders niet globaal zichtbaar)
  // ========================================
  // DAG-AANBIEDINGEN (DEALS)
  // ========================================
  // Foto kiezen, verkleinen en als data-URI bewaren
  window.__savoraDealImage = '';
  function handleDealImageSelect(e) {
    var file = e.target.files && e.target.files[0];
    var prev = document.getElementById('dealImagePreview');
    if (!file) { window.__savoraDealImage = ''; if (prev) prev.style.display = 'none'; return; }
    var reader = new FileReader();
    reader.onload = function(ev) {
      var img = new Image();
      img.onload = function() {
        var maxDim = 900;
        var w = img.width, h = img.height;
        if (w > maxDim || h > maxDim) {
          if (w > h) { h = Math.round(h * maxDim / w); w = maxDim; }
          else { w = Math.round(w * maxDim / h); h = maxDim; }
        }
        var canvas = document.createElement('canvas');
        canvas.width = w; canvas.height = h;
        canvas.getContext('2d').drawImage(img, 0, 0, w, h);
        try { window.__savoraDealImage = canvas.toDataURL('image/jpeg', 0.7); } catch (err) { window.__savoraDealImage = ''; }
        if (prev && window.__savoraDealImage) { prev.src = window.__savoraDealImage; prev.style.display = 'block'; }
      };
      img.onerror = function(){ window.__savoraDealImage = ''; };
      img.src = ev.target.result;
    };
    reader.readAsDataURL(file);
  }
  (function(){
    function attach(){ var fi = document.getElementById('dealImageFile'); if (fi) fi.addEventListener('change', handleDealImageSelect); }
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', attach); else attach();
  })();

  // ===== OpenStreetMap adres-kiezer (gratis, geen API-sleutel) =====
  var _addrMap=null, _addrMarker=null, _addrTimer=null, _addrSearchBound=false, _addrMapTries=0;
  function setupAddrSearchOnce(){
    if (_addrSearchBound) return;
    var search = document.getElementById('addrSearch');
    if (!search) return;
    _addrSearchBound = true;
    search.addEventListener('input', function(){
      clearTimeout(_addrTimer);
      var q = search.value.trim();
      var r = document.getElementById('addrResults');
      if (q.length < 3){ if (r) r.style.display='none'; return; }
      _addrTimer = setTimeout(function(){ doAddrSearch(q); }, 500);
    });
    document.addEventListener('click', function(e){
      var box = document.getElementById('addrResults');
      if (box && e.target !== search && !box.contains(e.target)) box.style.display='none';
    });
  }
  function initAddressMap(){
    setupAddrSearchOnce();
    var el = document.getElementById('addrMap');
    if (!el) return;
    if (!window.L){ if (_addrMapTries++ < 15) setTimeout(initAddressMap, 400); return; }
    el.style.display='block';
    if (_addrMap){ setTimeout(function(){ _addrMap.invalidateSize(); }, 150); return; }
    _addrMap = L.map('addrMap').setView([41.3275, 19.8187], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { maxZoom: 19, attribution: 'Â© OpenStreetMap' }).addTo(_addrMap);
    setTimeout(function(){ _addrMap.invalidateSize(); }, 200);
    _addrMap.on('click', function(e){ reverseGeocode(e.latlng.lat, e.latlng.lng); });
  }
  function doAddrSearch(q){
    fetch('https://nominatim.openstreetmap.org/search?format=jsonv2&addressdetails=1&countrycodes=al&limit=5&q=' + encodeURIComponent(q), { headers: { 'Accept-Language': 'sq' } })
      .then(function(r){ return r.json(); })
      .then(function(list){
        var box = document.getElementById('addrResults');
        if (!box) return;
        if (!list || !list.length){ box.innerHTML = '<div style="padding:10px;color:#888;font-size:0.8rem">AsnjÃ« rezultat</div>'; box.style.display='block'; return; }
        box.innerHTML = list.map(function(it, i){
          return '<div class="addr-opt" data-i="' + i + '" style="padding:8px 10px;cursor:pointer;border-bottom:1px solid var(--gray-100);font-size:0.8rem">ðŸ“ ' + escapeHtml(it.display_name) + '</div>';
        }).join('');
        box.style.display='block';
        box.querySelectorAll('.addr-opt').forEach(function(opt){
          opt.addEventListener('click', function(){ selectAddr(list[parseInt(opt.getAttribute('data-i'), 10)]); });
        });
      })
      .catch(function(){});
  }
  function reverseGeocode(lat, lng){
    fetch('https://nominatim.openstreetmap.org/reverse?format=jsonv2&addressdetails=1&lat=' + lat + '&lon=' + lng, { headers: { 'Accept-Language': 'sq' } })
      .then(function(r){ return r.json(); })
      .then(function(it){ if (it && it.display_name) selectAddr(it); })
      .catch(function(){});
  }
  function selectAddr(it){
    if (!it) return;
    var addrEl = document.getElementById('dealAddress');
    var a = it.address || {};
    var line = '';
    if (a.road) line += a.road + (a.house_number ? ' ' + a.house_number : '');
    var cityName = a.city || a.town || a.village || a.municipality || a.county || '';
    if (line && cityName) line += ', ' + cityName;
    if (!line) line = it.display_name;
    if (addrEl) addrEl.value = line;
    var latEl = document.getElementById('dealLat'); if (latEl) latEl.value = it.lat;
    var lngEl = document.getElementById('dealLng'); if (lngEl) lngEl.value = it.lon;
    var box = document.getElementById('addrResults'); if (box) box.style.display='none';
    var searchEl = document.getElementById('addrSearch'); if (searchEl) searchEl.value = line;
    if (cityName){
      var sel = document.getElementById('dealCity');
      if (sel){ for (var i=0;i<sel.options.length;i++){ if (sel.options[i].value && sel.options[i].value.toLowerCase() === cityName.toLowerCase()){ sel.value = sel.options[i].value; break; } } }
    }
    if (_addrMap){
      var ll = [parseFloat(it.lat), parseFloat(it.lon)];
      _addrMap.setView(ll, 16);
      if (_addrMarker) _addrMarker.setLatLng(ll); else _addrMarker = L.marker(ll).addTo(_addrMap);
    }
  }

  function handleDealSubmit(e) {
    e.preventDefault();
    var btn = document.getElementById('dealSubmitBtn');
    var errDiv = document.getElementById('dealError');
    var succDiv = document.getElementById('dealSuccess');
    if (errDiv) errDiv.innerHTML = '';
    if (succDiv) succDiv.innerHTML = '';

    var title = document.getElementById('dealTitle').value.trim();
    var description = document.getElementById('dealDescription').value.trim();
    var originalPrice = document.getElementById('dealOriginalPrice').value.trim();
    var dealPrice = document.getElementById('dealPrice').value.trim();
    var category = document.getElementById('dealCategory').value;
    var quantity = document.getElementById('dealQuantity').value.trim();
    var city = document.getElementById('dealCity').value.trim();
    var address = document.getElementById('dealAddress').value.trim();
    var image = window.__savoraDealImage || '';

    if (!title || !dealPrice || !address || !city) {
      if (errDiv) errDiv.innerHTML = '<div class="error-msg">PlotÃ«soni titullin, Ã§mimin, qytetin dhe adresÃ«n e ofertÃ«s.</div>';
      return;
    }
    if (!partnerToken) {
      if (errDiv) errDiv.innerHTML = '<div class="error-msg">Identifikohuni pÃ«rsÃ«ri pÃ«r tÃ« vazhduar.</div>';
      return;
    }

    if (btn) { btn.disabled = true; btn.textContent = 'Duke publikuar...'; }

    fetch(API_BASE + '/api/deals', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + partnerToken },
      body: JSON.stringify({
        title: title,
        description: description,
        category: category,
        city: city,
        address: address,
        lat: (document.getElementById('dealLat') ? document.getElementById('dealLat').value : '') || null,
        lng: (document.getElementById('dealLng') ? document.getElementById('dealLng').value : '') || null,
        imageUrl: image,
        quantity: quantity,
        originalPrice: originalPrice ? Number(originalPrice) : null,
        dealPrice: Number(dealPrice)
      })
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (btn) { btn.disabled = false; btn.textContent = 'Publiko ofertÃ«n (1 Kredit)'; }
      if (data && data.success) {
        if (succDiv) succDiv.innerHTML = '<div class="success-msg">Oferta u publikua! 1 kredit u pÃ«rdor.</div>';
        var f = document.getElementById('dealForm'); if (f) f.reset();
        window.__savoraDealImage = '';
        var pv = document.getElementById('dealImagePreview'); if (pv) { pv.src = ''; pv.style.display = 'none'; }
        loadMyDeals();
        var pid = localStorage.getItem('savora_partner_id');
        if (pid && typeof loadCreditsFromAPI === 'function') loadCreditsFromAPI(pid);
      } else {
        var emsg = (data && data.error) ? data.error : 'DiÃ§ka shkoi keq. Provoni pÃ«rsÃ«ri.';
        if (errDiv) errDiv.innerHTML = creditAwareError(emsg, 1);
        if (typeof syncFormBalance === 'function') syncFormBalance();
      }
    })
    .catch(function(){
      if (btn) { btn.disabled = false; btn.textContent = 'Publiko ofertÃ«n (1 Kredit)'; }
      if (errDiv) errDiv.innerHTML = '<div class="error-msg">Lidhja dÃ«shtoi. Provoni pÃ«rsÃ«ri.</div>';
    });
  }

  function loadMyDeals() {
    var list = document.getElementById('myDealsList');
    if (!list) return;
    if (!partnerToken) {
      list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">Identifikohuni pÃ«r tÃ« parÃ« ofertat tuaja.</p>';
      return;
    }
    list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">Po ngarkohet...</p>';
    fetch(API_BASE + '/api/deals/mine', {
      headers: { 'Authorization': 'Bearer ' + partnerToken }
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (!data || !data.success) {
        list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">S\'u ngarkuan ofertat.</p>';
        return;
      }
      var deals = data.deals || [];
      if (deals.length === 0) {
        list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">Nuk ka oferta ende. Krijoni tÃ« parÃ«n!</p>';
        return;
      }
      var esc = function(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); };
      var now = Date.now();
      list.innerHTML = deals.map(function(d){
        var expired = d.expiresAt && new Date(d.expiresAt).getTime() < now;
        var soldOut = d.soldOut === true;
        var stopped = d.active === false && !soldOut;
        var priceLine = (d.dealPrice != null ? d.dealPrice + ' L' : '');
        if (d.originalPrice && Number(d.originalPrice) > Number(d.dealPrice)) {
          priceLine += ' <span style="text-decoration:line-through;color:var(--gray-400);font-size:0.8rem">' + esc(d.originalPrice) + ' L</span>';
        }
        var qtyTxt = '';
        var qn = parseInt(d.quantity, 10);
        if (!isNaN(qn)) qtyTxt = ' Â· ' + qn + ' tÃ« mbetura';
        var status, statusStyle;
        if (soldOut) { status = 'Shitur'; statusStyle = 'background:#FEF3C7;color:#92400E'; }
        else if (stopped) { status = 'Ndaluar'; statusStyle = 'background:#F3F4F6;color:#6B7280'; }
        else if (expired) { status = 'Skaduar'; statusStyle = 'background:#FEE2E2;color:#991B1B'; }
        else { status = 'Aktive'; statusStyle = 'background:#DCFCE7;color:#166534'; }
        var canStop = !soldOut && !stopped && !expired;
        return '<div style="border:1px solid var(--gray-200);border-radius:10px;padding:12px;margin-bottom:8px;display:flex;justify-content:space-between;align-items:center;gap:12px">' +
          '<div style="min-width:0"><div style="font-weight:600;font-size:0.9rem">' + esc(d.title) + '</div>' +
          '<div style="font-size:0.8rem;color:var(--gray-500)">' + priceLine + (d.city ? ' Â· ' + esc(d.city) : '') + qtyTxt + '</div></div>' +
          '<div style="display:flex;align-items:center;gap:8px;white-space:nowrap">' +
          '<span style="font-size:0.72rem;font-weight:600;padding:4px 10px;border-radius:999px;' + statusStyle + '">' + status + '</span>' +
          (canStop ? '<button type="button" class="deal-stop-btn" data-id="' + esc(d.id) + '" style="border:1px solid #FCA5A5;background:#fff;color:#dc2626;font-size:0.72rem;font-weight:600;padding:5px 10px;border-radius:8px;cursor:pointer">Ndalo</button>' : '') +
          '</div>' +
          '</div>';
      }).join('');
      list.querySelectorAll('.deal-stop-btn').forEach(function(b){
        b.addEventListener('click', function(){ stopDeal(b.getAttribute('data-id')); });
      });
    })
    .catch(function(){
      list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">S\'u ngarkuan ofertat.</p>';
    });
  }

  function stopDeal(dealId) {
    if (!dealId || !partnerToken) return;
    if (!confirm('Ndalo kÃ«tÃ« ofertÃ«? Nuk do tÃ« shfaqet mÃ« te klientÃ«t.')) return;
    fetch(API_BASE + '/api/deals/delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + partnerToken },
      body: JSON.stringify({ dealId: dealId })
    })
    .then(function(r){ return r.json(); })
    .then(function(data){ if (data && data.success) loadMyDeals(); else alert((data && data.error) || 'Nuk u ndal dot.'); })
    .catch(function(){ alert('Lidhja dÃ«shtoi.'); });
  }

  function loadMyClaims() {
    var list = document.getElementById('myClaimsList');
    if (!list) return;
    if (!partnerToken) { list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">Identifikohuni.</p>'; return; }
    list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">Po ngarkohet...</p>';
    fetch(API_BASE + '/api/deals/claims', { headers: { 'Authorization': 'Bearer ' + partnerToken } })
    .then(function(r){ return r.json(); })
    .then(function(data){
      if (!data || !data.success) { list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">S\'u ngarkuan.</p>'; return; }
      var claims = data.claims || [];
      if (claims.length === 0) { list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">Ende askush nuk ka kÃ«rkuar njÃ« ofertÃ«.</p>'; return; }
      var esc = function(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); };
      list.innerHTML = claims.map(function(c){
        var dt = new Date(c.createdAt);
        var when = isNaN(dt.getTime()) ? '' : (dt.toLocaleDateString('sq-AL') + ' ' + dt.toLocaleTimeString('sq-AL', {hour:'2-digit',minute:'2-digit'}));
        var contact = [c.phone, c.email].filter(Boolean).join(' Â· ');
        return '<div style="border:1px solid var(--gray-200);border-radius:10px;padding:12px;margin-bottom:8px">' +
          '<div style="font-weight:600;font-size:0.9rem">' + esc(c.name || 'Klient') + (c.dealTitle ? ' <span style="font-weight:400;color:var(--gray-500)">â€” ' + esc(c.dealTitle) + '</span>' : '') + '</div>' +
          '<div style="font-size:0.82rem;color:var(--gray-600)">' + esc(contact) + '</div>' +
          '<div style="font-size:0.72rem;color:var(--gray-400);margin-top:2px">' + esc(when) + '</div>' +
          '</div>';
      }).join('');
    })
    .catch(function(){ list.innerHTML = '<p style="text-align:center;color:var(--gray-400);padding:20px">S\'u ngarkuan.</p>'; });
  }

  Object.assign(window, {
    switchTab, switchAuthTab, setLang, toggleLangDropdown, toggleMobileNav, togglePw,
    showLogin, showRegister, showForgotPassword, logout,
    verifyRegistrationCode, resendVerifyCodeWithTimer,
    selectPackage, skipPricing, buyCreditsViaPaysera, copyIban, closePayment,
    choosePayment, closePayMethod, payWith, applyPromoCode,
    handleAdSubmit, deleteAd, onAdPlanChange, addItem, removeItem, saveInvoice, previewInvoice, resetInvoice, closePrint,
    handleDealSubmit, loadMyDeals, stopDeal, loadMyClaims,
    validateNuiRealtime
  });

  // Initialize when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
})();
</script>

</body>
</html>