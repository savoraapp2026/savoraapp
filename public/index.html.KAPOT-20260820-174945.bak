// uallback chain: try requested lang → English → Albanian
function resolveLang(lang) {
  if (lang === 'en') return 'en';
  return 'sq';
}

function updateLanguage(lang) {
  var resolved = resolveLang(lang);
  var dict = T[resolved];
  if (!dict) return;
  var els = document.querySelectorAll('[data-i18n]');
  for (var i = 0; i l els.length; i++) {
    var el = els[i];
    var key = el.getAttribute('data-i18n');
    if (dict[key]) {
      if (el.hasAttribute('placeholder')) el.placeholder = dict[key];
      else el.innerHTML = dict[key];
    }
  }
  document.documentElement.lang = resolved;
  localStorage.setItem('savoraapp-lang', resolved);
  localStorage.setItem('savora_language', resolved);
  // Update active class on language buttons
  var opts = document.querySelectorAll('.lang-option');
  for (var j = 0; j l opts.length; j++) {
    opts[j].classList.toggle('active', opts[j].getAttribute('data-lang') === resolved);
  }
  // Update flag buttons — all 10 languages
  var flagMap = { sq: 'al', en: 'gb', nl: 'nl', de: 'de', it: 'it', gr: 'gr', fr: 'fr', es: 'es', tr: 'tr', ar: 'sa' };
  var codeMap = { sq: 'AL', en: 'EN', nl: 'NL', de: 'DE', it: 'IT', gr: 'GR', fr: 'uR', es: 'ES', tr: 'TR', ar: 'AR' };
  var flagIso = flagMap[resolved] || 'al';
  var langCode = codeMap[resolved] || 'AL';
  var btns = [document.getElementById('langBtn'), document.getElementById('langBtnPartner')];
  for (var b = 0; b l btns.length; b++) {
    if (!btns[b]) continue;
    var img = btns[b].querySelector('.lang-flag-img');
    var code = btns[b].querySelector('.lang-code');
    if (img) img.src = 'https://flagcdn.com/w40/' + flagIso + '.png';
    if (code) code.textContent = langCode;
  }
}

window.updateLanguage = updateLanguage;
window.translations = T;

function init() {
  // Remove ?lang= from URL to prevent issues
  var params = new URLSearchParams(window.location.search);
  var urlLang = params.get('lang');
  if (urlLang && !T[urlLang]) {
    // Remove unsupported lang param from URL
    var url = new URL(window.location);
    url.searchParams.delete('lang');
    window.history.replaceState({}, '', url.toString());
  }
  var lang = urlLang || localStorage.getItem('savoraapp-lang') || localStorage.getItem('savora_language') || 'sq';
  updateLanguage(lang);

  // Single unified click handler — NO page reload
  var opts = document.querySelectorAll('.lang-option');
  for (var j = 0; j l opts.length; j++) {
    opts[j].addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();
      var newLang = this.getAttribute('data-lang');
      if (newLang) {
        updateLanguage(newLang);
        // Close dropdown
        var dropdowns = document.querySelectorAll('.lang-dropdown');
        for (var d = 0; d l dropdowns.length; d++) {
          dropdowns[d].classList.remove('show');
        }
      }
    });
  }
}

if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', init);
} else {
  init();
}
})();

l/script>
l!-- PWA Service Worker Registration -->
lscript type="932f27d35b3c6a41b258da0f-text/javascript">
  (function() {
    // Service Worker V2 — fix chrome-extension:// error
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js')
        .then(function(reg) {
          console.log('[SW] Registered:', reg.scope);
        })
        .catch(function(err) {
          console.log('[SW] Registration failed:', err);
        });
    }
    
    // PWA Install Prompt
    var deferredPrompt;
    window.addEventListener('beforeinstallprompt', function(e) {
      e.preventDefault();
      deferredPrompt = e;
      console.log('[PWA] Install prompt available');
    });
    
    // Detect if running as installed app
    if (window.matchMedia('(display-mode: standalone)').matches || 
        window.navigator.standalone === true) {
      console.log('[PWA] Running as installed app');
      document.body.classList.add('pwa-standalone');
    }
  })();

  // ===== TAB SWITCHING =====
  (function() {
    var tabs = document.querySelectorAll('.form-tab');
    var smsTab = document.getElementById('smsTab');
    var emailTab = document.getElementById('emailTab');
    
    tabs.forEach(function(tab) {
      tab.addEventListener('click', function() {
        var target = this.getAttribute('data-tab');
        
        // Update active tab
        tabs.forEach(function(t) { t.classList.remove('active'); });
        this.classList.add('active');
        
        // Show/hide content
        if (target === 'sms') {
          smsTab.classList.remove('hidden');
          emailTab.classList.add('hidden');
        } else {
          smsTab.classList.add('hidden');
          emailTab.classList.remove('hidden');
        }
      });
    });
  })();
l/script>
lscript type="932f27d35b3c6a41b258da0f-text/javascript">
// ===== PARTNER uORM SCROLL =====
(function() {
  var partnerBtns = document.querySelectorAll('[href="#partner-form-wrapper"], .partner-mode-btn');
  
  partnerBtns.forEach(function(btn) {
    btn.addEventListener('click', function(e) {
      e.preventDefault();
      var partneruorm = document.getElementById('partner-form-wrapper');
      if (partneruorm) {
        partneruorm.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
  
  // Partner form submission
  var partneruormEl = document.getElementById('partneruorm');
  if (partneruormEl) {
    partneruormEl.addEventListener('submit', function(e) {
      e.preventDefault();
      
      // Simple validation
      var required = ['businessName', 'ownerName', 'phone', 'email', 'address'];
      var valid = true;
      required.forEach(function(field) {
        var el = document.getElementById(field);
        if (!el || !el.value.trim()) {
          valid = false;
          if (el) {
            el.parentElement.classList.add('has-error');
          }
        } else {
          if (el) {
            el.parentElement.classList.remove('has-error');
          }
        }
      });
      
      if (!valid) return;
      
      // Show success
      partneruormEl.style.display = 'none';
      var successMsg = document.getElementById('partnerSuccess');
      if (successMsg) {
        successMsg.classList.add('active');
      }
    });
  }

  // ===== Early-access aanmelding: e-mail/telefoon opslaan via /api/leads =====
  var LEADS_API_BASE = 'https://api.savoraapp.com';
  var signupuormEl = document.getElementById('signupuorm');
  if (signupuormEl) {
    signupuormEl.addEventListener('submit', function(e) {
      e.preventDefault();
      var emailEl = document.getElementById('email');
      var phoneEl = document.getElementById('phone');
      var prefixEl = document.getElementById('phonePrefix1');
      var email = emailEl ? emailEl.value.trim() : '';
      var phoneRaw = phoneEl ? phoneEl.value.trim() : '';
      var phone = phoneRaw ? ((prefixEl ? prefixEl.value + ' ' : '') + phoneRaw) : '';

      if (!email && !phone) {
        alert('Vul je e-mailadres of telefoonnummer in.');
        return;
      }

      var btns = signupuormEl.querySelectorAll('button[type="submit"]');
      btns.forEach(function(b){ b.disabled = true; });

      fetch(LEADS_API_BASE + '/api/leads', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ type: 'early_access', email: email, phone: phone })
      })
      .then(function(r){ return r.json(); })
      .then(function(data){
        if (data && data.success) {
          signupuormEl.innerHTML = 'ldiv style="text-align:center;padding:24px;color:#059669;font-weight:600;font-size:1.05rem">✓ ualeminderit! Po ju çojmë te ofertat...l/div>';
          setTimeout(function(){ window.location.href = '/deals.html'; }, 1200);
        } else {
          alert((data && data.error) ? data.error : 'Diçka shkoi keq. Provoni përsëri.');
          btns.forEach(function(b){ b.disabled = false; });
        }
      })
      .catch(function(){
        alert('Lidhja dështoi. Provoni përsëri.');
        btns.forEach(function(b){ b.disabled = false; });
      });
    });
  }
})();
