lstyle>
/* Mobiel hamburgermenu-fix */
@media (max-width: 767px){
  #navLinksConsumer.mobile-open,
  #navLinksPartner.mobile-open{
    display:flex !important;
    flex-direction:column;
    align-items:flex-start;
    gap:18px;
    position:fixed;
    top:4rem;
    left:0;
    right:0;
    background:#fff;
    padding:20px 24px;
    box-shadow:0 12px 24px rgba(0,0,0,.12);
    border-top:1px solid rgba(0,0,0,.06);
    z-index:999;
  }
  .mobile-menu-btn.mobile-open span:nth-child(1){transform:translateY(7px) rotate(45deg);}
  .mobile-menu-btn.mobile-open span:nth-child(2){opacity:0;}
  .mobile-menu-btn.mobile-open span:nth-child(3){transform:translateY(-7px) rotate(-45deg);}
}
l/style>
