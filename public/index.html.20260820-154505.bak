<input class="form-input" data-i18n="tk92" id="website" name="website" placeholder="www.biznesi.com ose @instagram" type="url"/>
</div>
<div class="form-group">
<label data-i18n="message" for="message">Mesazhi Juaj (opsionale)</label>
<textarea class="form-input" data-i18n="tk93" id="message" name="message" placeholder="Na tregoni më shumë për biznesin tuaj..." rows="3"></textarea>
</div>
<div class="form-group checkbox-group">
<label class="checkbox-label">
<input id="terms" name="terms" required="" type="checkbox"/>
<span class="checkmark"></span>
<span data-i18n="termsText">Unë pranoj <a data-i18n="termsLink" href="#">kushtet e përdorimit</a> dhe <a data-i18n="privacyLink" href="#">politikën e privatësisë</a> *</span>
</label>
<span class="error-message" data-i18n="errorTerms">Ju lutem pranoni kushtet</span>
</div>
<button class="btn btn-primary btn-full" data-i18n="submitButton" type="submit">
<span>Dërgo Aplikimin</span>
<svg class="btn-arrow" fill="currentColor" viewbox="0 0 20 20">
<path clip-rule="evenodd" d="M10.293 3.293a1 1 0 011.414 0l6 6a1 1 0 010 1.414l-6 6a1 1 0 01-1.414-1.414L14.586 11H3a1 1 0 110-2h11.586l-4.293-4.293a1 1 0 010-1.414z" fill-rule="evenodd"></path>
</svg>
</button>
<div class="form-success" id="formSuccess">
<div class="success-icon">✓</div>
<h4 data-i18n="successTitle">ualeminderit!</h4>
<p data-i18n="successMessage">Aplikimi juaj u dërgua me sukses. Do t'ju kontaktojmë brenda 24 orëve.</p>
</div>





