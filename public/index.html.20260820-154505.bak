<div id="cookieBanner" style="display:none;position:fixed;left:0;right:0;bottom:0;z-index:9999;background:#ffffff;border-top:1px solid #e5e7eb;box-shadow:0 -4px 20px rgba(0,0,0,0.08);padding:16px 20px;">
<div style="max-width:1100px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;justify-content:space-between;">
<p data-i18n="tk90" style="margin:0;flex:1 1 320px;color:#374151;font-size:0.92rem;line-height:1.5;">
      🍪 Ne përdorim cookies për të përmirësuar përvojën tuaj. Cookies thelbësore janë gjithmonë aktive. Lexoni më shumë në <a href="/cookie-policy.html" style="color:#059669;font-weight:600;text-decoration:underline;">Politikën e Cookies</a>.
    </p>
<div style="display:flex;gap:10px;flex:0 0 auto;">
<button id="cookieDecline" style="padding:10px 18px;border:1px solid #d1d5db;background:#fff;color:#374151;border-radius:8px;font-weight:600;font-size:0.9rem;cursor:pointer;" type="button">Refuzo</button>
<button id="cookieAccept" style="padding:10px 18px;border:none;background:#059669;color:#fff;border-radius:8px;font-weight:600;font-size:0.9rem;cursor:pointer;" type="button">Prano</button>
</div>
</div>
</div>
<script type="932f27d35b3c6a41b258da0f-text/javascript">
(function(){
  // ----- Cookie-consent -----
  var KEY = 'savoraapp-cookie-consent';
  var banner = document.getElementById('cookieBanner');
  function setConsent(v){
    try { localStorage.setItem(KEY, v); } catch(e){}
    window.__savoraCookieConsent = v;
    if (banner) banner.style.display = 'none';
  }
  var prior = null;
  try { prior = localStorage.getItem(KEY); } catch(e){}
  if (prior) {
    window.__savoraCookieConsent = prior;
  } else if (banner) {
    banner.style.display = 'block';
  }
  var ba = document.getElementById('cookieAccept');
  var bd = document.getElementById('cookieDecline');
  if (ba) ba.addEventListener('click', function(){ setConsent('accepted'); });
  if (bd) bd.addEventListener('click', function(){ setConsent('declined'); });

  // ----- Live statistieken met tel-animatie (basis + echte activiteit) -----
  function fmt(n){ try { return Number(Math.round(n)).toLocaleString('de-DE'); } catch(e){ return String(n); } }
  function animateCount(id, target){
    var el = document.getElementById(id);
    if (!el) return;
    var start = 0, dur = 1100, t0 = null;
    function step(ts){
      if (t0 === null) t0 = ts;
      var p = Math.min((ts - t0) / dur, 1);
      var eased = 1 - Math.pow(1 - p, 3); // ease-out
      el.textContent = fmt(start + (target - start) * eased);
      if (p < 1) requestAnimationurame(step);
    }
    requestAnimationurame(step);
  }
  function applyStats(d){
    if (!d) return;
    if (typeof d.users === 'number') { animateCount('statUsers', d.users); animateCount('statUsersuooter', d.users); }
    if (typeof d.partners === 'number') { animateCount('statPartners', d.partners); animateCount('statPartnersuooter', d.partners); }
    if (typeof d.reservations === 'number') { animateCount('statReservations', d.reservations); }
  }
  // Animeer eerst de basisgetallen, werk daarna bij met echte data van de API
  applyStats({ users: 787, partners: 64, reservations: 3655 });
  fetch('https://api.savoraapp.com/api/stats')
    .then(function(r){ return r.ok ? r.json() : null; })
    .then(function(d){ applyStats(d); })
    .catch(function(){ /* basisgetallen blijven staan */ });
})();
</script>
<script type="932f27d35b3c6a41b258da0f-text/javascript">
// Toon promotie-advertenties (⭐) eerst, dan gewone aanbiedingen, in een scrollende strip; val terug op voorbeelden als er nog niets is
(function(){
  var el = document.getElementById('appContent');
  if (!el) return;
  var catEmoji = { food: '🍽️', bakery: '🥐', produce: '🍎', meat: '🥩', dairy: '🧀', other: '🍴' };
  var fallback = [
    { category:'bakery', title:'Bukë e ureskët', dealPrice:'350', originalPrice:'700' },
    { category:'produce', title:'uruta Mix', dealPrice:'500', originalPrice:'1,200' },
    { category:'food', title:'Menu uast uood', dealPrice:'400', originalPrice:'900' }
  ];
  function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]; }); }
  function card(item, isAd){
    var emoji = catEmoji[item.category] || '🍴';
    var price = isAd ? item.price : item.dealPrice;
    var oldP = (!isAd && item.originalPrice != null && item.originalPrice !== '')
      ? '<span class="app-card-old">' + esc(item.originalPrice) + ' ALL</span>' : '';
    var priceHtml = (price != null && price !== '') ? ('<span class="app-card-price">' + esc(price) + ' ALL</span>') : '';
    return '<div class="app-card">' +
        '<div class="app-card-image">' + emoji + '</div>' +
        '<div class="app-card-info">' +
          '<span class="app-card-title">' + (isAd ? '⭐ ' : '') + esc(item.title) + '</span>' +
          priceHtml + oldP +
        '</div>' +
      '</div>';
  }
  function renderScroller(cards){
    var n = cards.length;
    if (!n) return;
    var html = cards.join('');
    var animate = n >= 3;
    var dur = Math.max(12, n * 5);
    el.innerHTML = '<div class="app-scroller" style="' + (animate ? ('animation-duration:' + dur + 's') : 'animation:none') + '">' + html + (animate ? html : '') + '</div>';
  }
  function getJSON(url){ return fetch(url).then(function(r){ return r.ok ? r.json() : null; }).catch(function(){ return null; }); }
  Promise.all([ getJSON('https://api.savoraapp.com/api/ads'), getJSON('https://api.savoraapp.com/api/deals') ])
    .then(function(res){
      var ads = (res[0] && res[0].ads) || [];
      var deals = (res[1] && res[1].deals) || [];
      var arr = ads.map(function(a){ return card(a, true); }).concat(deals.map(function(d){ return card(d, false); }));
      if (!arr.length) arr = fallback.map(function(d){ return card(d, false); });
      renderScroller(arr.slice(0, 8));
    });
})();
</script>
<script>
(function(){
  function initMobileMenu(){
    var btn=document.getElementById('mobileMenuBtn');
    if(!btn||btn._wired) return;
    btn._wired=true;
    btn.addEventListener('click',function(e){
      e.preventDefault();
      var partner=document.getElementById('navLinksPartner');
      var consumer=document.getElementById('navLinksConsumer');
      var menu=(partner&&!partner.classList.contains('hidden'))?partner:consumer;
      if(!menu) return;
      menu.classList.toggle('mobile-open');
      btn.classList.toggle('mobile-open');
    });
    ['navLinksConsumer','navLinksPartner'].forEach(function(id){
      var m=document.getElementById(id);
      if(!m) return;
      m.querySelectorAll('a').forEach(function(a){
        a.addEventListener('click',function(){
          m.classList.remove('mobile-open');
          btn.classList.remove('mobile-open');
        });
      });
    });
  }
  if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',initMobileMenu);
  else initMobileMenu();
})();
</script>
