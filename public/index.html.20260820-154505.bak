<!-- CLEAR SERVICE WORKER CACHE - Auto-clear bij elke nieuwe versie -->
<script type="932f27d35b3c6a41b258da0f-text/javascript">
    (function() {
      // uorce unregister all service workers
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.getRegistrations().then(function(regs) {
          regs.forEach(function(r) { r.unregister(); });
        });
      }
      // Clear all caches
      if ('caches' in window) {
        caches.keys().then(function(names) {
          names.forEach(function(n) { caches.delete(n); });
        });
      }
    })();
  </script>
