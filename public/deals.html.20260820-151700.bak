<!DOCTYPE html>
<html lang="sq">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ofertat e sotme · Savora</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
  :root{
    --green:#10B981; --greenD:#059669; --greenL:#D1FAE5;
    --dark:#0F172A; --dark8:#1E293B; --gray:#64748B; --grayL:#94A3B8;
    --grayB:#E2E8F0; --grayS:#F1F5F9; --light:#F8FAFC; --white:#fff;
    --yellow:#F59E0B; --rose:#F43F5E;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:'Inter',system-ui,sans-serif;background:var(--light);color:var(--dark);-webkit-font-smoothing:antialiased;line-height:1.5}
  a{color:inherit;text-decoration:none}
  img{max-width:100%;display:block}

  /* Topbar */
  .topbar{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--grayB)}
  .topbar-inner{max-width:1120px;margin:0 auto;padding:14px 20px;display:flex;align-items:center;justify-content:space-between}
  .brand{display:flex;align-items:center;gap:10px;font-weight:800;font-size:1.15rem}
  .brand .dot{width:30px;height:30px;border-radius:9px;background:linear-gradient(135deg,var(--green),var(--greenD));display:grid;place-items:center;color:#fff;font-size:1rem}
  .back{font-size:.9rem;font-weight:600;color:var(--gray);padding:8px 14px;border-radius:9px}
  .back:hover{background:var(--grayS);color:var(--dark)}

  /* Hero */
  .hero{max-width:1120px;margin:0 auto;padding:40px 20px 8px}
  .eyebrow{display:inline-flex;align-items:center;gap:8px;background:var(--greenL);color:var(--greenD);font-weight:700;font-size:.78rem;letter-spacing:.02em;padding:6px 12px;border-radius:999px;text-transform:uppercase}
  .hero h1{font-size:clamp(1.9rem,5vw,2.8rem);font-weight:800;letter-spacing:-.02em;margin:16px 0 8px}
  .hero p{color:var(--gray);font-size:1.05rem;max-width:560px}

  /* Grid */
  .grid{max-width:1120px;margin:0 auto;padding:28px 20px 80px;display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:20px}

  /* Card */
  .card{background:var(--white);border:1px solid var(--grayB);border-radius:18px;overflow:hidden;display:flex;flex-direction:column;transition:transform .18s ease,box-shadow .18s ease}
  .card:hover{transform:translateY(-4px);box-shadow:0 18px 40px -18px rgba(15,23,42,.28)}
  .card-media{position:relative;aspect-ratio:16/10;background:linear-gradient(135deg,var(--greenL),#ecfdf5);display:grid;place-items:center;font-size:3rem}
  .badge-discount{position:absolute;top:12px;left:12px;background:var(--yellow);color:#fff;font-weight:800;font-size:.85rem;padding:5px 11px;border-radius:999px;box-shadow:0 4px 12px -3px rgba(245,158,11,.6)}
  .badge-time{position:absolute;top:12px;right:12px;background:rgba(15,23,42,.78);color:#fff;font-weight:600;font-size:.72rem;padding:5px 10px;border-radius:999px;display:flex;align-items:center;gap:5px}
  .badge-time.urgent{background:var(--rose)}
  .card-body{padding:18px;display:flex;flex-direction:column;gap:10px;flex:1}
  .card-title{font-size:1.12rem;font-weight:700;letter-spacing:-.01em}
  .card-meta{font-size:.85rem;color:var(--gray);display:flex;align-items:center;gap:6px;flex-wrap:wrap}
  .card-meta .sep{opacity:.5}
  .card-desc{font-size:.9rem;color:var(--gray);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .price-row{display:flex;align-items:baseline;gap:10px;margin-top:auto}
  .price-now{font-size:1.5rem;font-weight:800;color:var(--greenD)}
  .price-old{font-size:.95rem;color:var(--grayL);text-decoration:line-through}
  .price-unit{font-size:.8rem;color:var(--gray);font-weight:500}
  .qty{font-size:.78rem;color:var(--gray);background:var(--grayS);padding:3px 9px;border-radius:999px;align-self:flex-start}
  .btn-claim{margin-top:4px;width:100%;border:none;cursor:pointer;font-family:inherit;font-weight:700;font-size:.95rem;color:#fff;background:linear-gradient(135deg,var(--green),var(--greenD));padding:13px;border-radius:11px;transition:filter .15s ease}
  .btn-claim:hover{filter:brightness(1.06)}
  .btn-claim:active{transform:translateY(1px)}

  /* City filter */
  .city-filter{max-width:1120px;margin:0 auto;padding:14px 20px 0;display:flex;gap:8px;flex-wrap:wrap}
  .city-chip{border:1.5px solid var(--grayB);background:#fff;color:var(--gray);font-family:inherit;font-weight:600;font-size:.85rem;padding:8px 16px;border-radius:999px;cursor:pointer;transition:border-color .15s ease,color .15s ease,background .15s ease}
  .city-chip:hover{border-color:var(--green);color:var(--greenD)}
  .city-chip.active{background:var(--greenD);border-color:var(--greenD);color:#fff}

  /* Card actions (map + claim) */
  .card-actions{display:flex;gap:8px;margin-top:4px}
  .card-actions .btn-claim{width:auto;flex:1;margin-top:0}
  .btn-map{flex:0 0 auto;border:1.5px solid var(--grayB);background:#fff;color:var(--greenD);font-family:inherit;font-weight:600;font-size:.9rem;padding:13px 15px;border-radius:11px;cursor:pointer;transition:border-color .15s ease,background .15s ease;white-space:nowrap}
  .btn-map:hover{border-color:var(--green);background:var(--greenL)}

  /* States */
  .state{max-width:560px;margin:40px auto;text-align:center;padding:48px 24px;color:var(--gray)}
  .state .emoji{font-size:3rem;margin-bottom:14px}
  .state h2{color:var(--dark);font-size:1.25rem;font-weight:700;margin-bottom:6px}
  .skeleton .card-media,.skeleton .ln{background:linear-gradient(90deg,var(--grayS) 25%,#e9eef5 37%,var(--grayS) 63%);background-size:400% 100%;animation:sh 1.3s ease infinite}
  .skeleton .ln{height:14px;border-radius:6px;margin:6px 0}
  @keyframes sh{0%{background-position:100% 0}100%{background-position:-100% 0}}

  /* Modal */
  .overlay{position:fixed;inset:0;background:rgba(15,23,42,.55);backdrop-filter:blur(3px);display:none;align-items:center;justify-content:center;padding:20px;z-index:60}
  .overlay.open{display:flex}
  .modal{background:#fff;border-radius:20px;width:100%;max-width:440px;padding:26px;box-shadow:0 30px 60px -20px rgba(15,23,42,.5);animation:pop .2s ease}
  @keyframes pop{from{transform:scale(.96);opacity:0}to{transform:scale(1);opacity:1}}
  .modal h3{font-size:1.3rem;font-weight:800;margin-bottom:4px}
  .modal .sub{color:var(--gray);font-size:.92rem;margin-bottom:18px}
  .modal .deal-chip{display:inline-block;background:var(--greenL);color:var(--greenD);font-weight:600;font-size:.85rem;padding:6px 12px;border-radius:10px;margin-bottom:18px}
  .field{margin-bottom:14px}
  .field label{display:block;font-size:.82rem;font-weight:600;color:var(--dark8);margin-bottom:6px}
  .field input{width:100%;font-family:inherit;font-size:1rem;padding:12px 14px;border:1.5px solid var(--grayB);border-radius:11px;transition:border-color .15s ease}
  .field input:focus{outline:none;border-color:var(--green);box-shadow:0 0 0 3px var(--greenL)}
  .modal-actions{display:flex;gap:10px;margin-top:8px}
  .btn-ghost{flex:1;border:1.5px solid var(--grayB);background:#fff;color:var(--gray);font-family:inherit;font-weight:600;padding:13px;border-radius:11px;cursor:pointer}
  .btn-ghost:hover{background:var(--grayS)}
  .btn-primary{flex:1.4;border:none;background:linear-gradient(135deg,var(--green),var(--greenD));color:#fff;font-family:inherit;font-weight:700;padding:13px;border-radius:11px;cursor:pointer}
  .btn-primary:disabled{opacity:.6;cursor:default}
  .modal-success{text-align:center;padding:14px 0}
  .modal-success .emoji{font-size:3rem;margin-bottom:10px}
  .modal-success h3{margin-bottom:6px}
  .err{color:var(--rose);font-size:.85rem;margin-top:-6px;margin-bottom:10px;display:none}

  @media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
  <header class="topbar">
    <div class="topbar-inner">
      <a class="brand" href="/index.html"><span class="dot">S</span> Savora</a>
      <a class="back" href="/index.html">← Kreu</a>
    </div>
  </header>

  <section class="hero">
    <span class="eyebrow">🥗 Ushqim i freskët, çmim i ulët</span>
    <h1>Ofertat e sotme</h1>
    <p>Produkte të freskëta nga bizneset pranë teje, me zbritje. Zgjidh një ofertë para se të mbarojë.</p>
  </section>

  <section id="promoSection" style="display:none;max-width:1100px;margin:0 auto;padding:0 20px">
    <h2 style="font-size:1.1rem;font-weight:800;color:#92400e;display:flex;align-items:center;gap:8px;margin:18px 0 12px">⭐ Oferta të Promovuara</h2>
    <div id="promoGrid" class="grid"></div>
  </section>

  <div id="cityFilter" class="city-filter"></div>
  <main id="dealsGrid" class="grid" aria-live="polite"></main>

  <!-- Claim modal -->
  <div class="overlay" id="overlay" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
    <div class="modal" id="modalBox">
      <div id="modalForm">
        <h3 id="modalTitle">E dua këtë ofertë</h3>
        <p class="sub">Lër të dhënat e tua dhe biznesi do të kontaktojë me ty.</p>
        <div class="deal-chip" id="modalDeal">—</div>
        <p style="background:#fffbeb;border:1px solid #fde68a;color:#92400e;font-size:.85rem;padding:9px 12px;border-radius:10px;margin-bottom:16px;">💵 Pagesa bëhet me para në dorë kur merrni produktin te biznesi. Nuk kërkohet pagesë online.</p>
        <div class="field">
          <label for="cName">Emri</label>
          <input type="text" id="cName" placeholder="Emri yt" autocomplete="name">
        </div>
        <div class="field">
          <label for="cEmail">Email</label>
          <input type="email" id="cEmail" placeholder="emri@shembull.com" autocomplete="email">
        </div>
        <div class="field">
          <label for="cPhone">Telefoni</label>
          <input type="tel" id="cPhone" placeholder="+355 69 608 0926" autocomplete="tel">
        </div>
        <div class="err" id="cErr">Shkruaj email ose numër telefoni.</div>
        <div class="modal-actions">
          <button class="btn-ghost" type="button" onclick="closeModal()">Anulo</button>
          <button class="btn-primary" type="button" id="cSubmit" onclick="submitClaim()">Dërgo</button>
        </div>
      </div>
      <div class="modal-success" id="modalSuccess" style="display:none">
        <div class="emoji">✅</div>
        <h3>Faleminderit!</h3>
        <p class="sub">Të dhënat u dërguan. Shkoni te biznesi dhe paguani me para në dorë kur merrni produktin.</p>
        <div id="successWhere" style="background:var(--greenL);color:var(--greenD);font-weight:600;font-size:.9rem;padding:10px 14px;border-radius:10px;margin-bottom:14px;display:none"></div>
        <div class="modal-actions">
          <button class="btn-ghost" type="button" onclick="closeModal()">Mbyll</button>
          <button class="btn-primary" type="button" id="mapsBtn">🧭 Hap Google Maps</button>
        </div>
      </div>
    </div>
  </div>

<script>
  var API_BASE = 'https://api.savoraapp.com';
  var currentDeal = null;

  function esc(s){ return String(s==null?'':s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];}); }

  function fmtPrice(v){
    if(v===null||v===undefined||v==='') return '';
    var n = Number(v);
    if(isNaN(n)) return esc(v);
    return n.toLocaleString('sq-AL') + ' L';
  }

  function timeLeft(expiresAt){
    if(!expiresAt) return null;
    var diff = new Date(expiresAt).getTime() - Date.now();
    if(diff<=0) return null;
    var h = Math.floor(diff/3600000);
    var m = Math.floor((diff%3600000)/60000);
    if(h>=1) return { txt: h+'h '+m+'m', urgent: h<2 };
    return { txt: m+'m', urgent: true };
  }

  function discountPct(orig, now){
    var o=Number(orig), n=Number(now);
    if(!o||isNaN(o)||isNaN(n)||o<=n) return null;
    return Math.round((1-(n/o))*100);
  }

  function mapQuery(d){
    if(d && d.lat!=null && d.lng!=null && String(d.lat)!=='' && String(d.lng)!==''){
      return String(d.lat) + ',' + String(d.lng);
    }
    if(d && d.address && String(d.address).trim()){
      var parts = [String(d.address).trim()];
      if(d.city) parts.push(d.city);
      parts.push('Shqipëri');
      return parts.join(', ');
    }
    return ((d && d.partnerName||'') + ' ' + (d && d.city||'')).trim();
  }

  function dealCard(d){
    var pct = discountPct(d.originalPrice, d.dealPrice);
    var tl = timeLeft(d.expiresAt);
    var media = d.imageUrl
      ? '<img src="'+esc(d.imageUrl)+'" alt="'+esc(d.title)+'" style="width:100%;height:100%;object-fit:cover">'
      : '🥗';
    var html = '<article class="card">';
    html += '<div class="card-media">'+ media;
    if(pct!==null) html += '<span class="badge-discount">-'+pct+'%</span>';
    if(tl) html += '<span class="badge-time'+(tl.urgent?' urgent':'')+'">⏱ '+esc(tl.txt)+'</span>';
    html += '</div>';
    html += '<div class="card-body">';
    html += '<div class="card-title">'+esc(d.title)+'</div>';
    var meta = [];
    if(d.partnerName) meta.push(esc(d.partnerName));
    if(d.city) meta.push(esc(d.city));
    html += '<div class="card-meta">'+ meta.join(' <span class="sep">·</span> ') +'</div>';
    if(d.description) html += '<div class="card-desc">'+esc(d.description)+'</div>';
    if(d.quantity) html += '<span class="qty">'+esc(d.quantity)+' në dispozicion</span>';
    html += '<div class="price-row"><span class="price-now">'+fmtPrice(d.dealPrice)+'</span>';
    if(d.originalPrice && Number(d.originalPrice)>Number(d.dealPrice)) html += '<span class="price-old">'+fmtPrice(d.originalPrice)+'</span>';
    html += '</div>';
    var mapQ = mapQuery(d);
    html += '<div class="card-actions">';
    if(mapQ) html += '<button class="btn-map" type="button" data-mapq="'+esc(mapQ)+'" title="Shiko në hartë">📍 Hartë</button>';
    html += '<button class="btn-claim" type="button" data-id="'+esc(d.id)+'">E dua këtë</button>';
    html += '</div>';
    html += '</div></article>';
    return html;
  }

  function render(deals){
    var grid = document.getElementById('dealsGrid');
    if(!deals || deals.length===0){
      grid.className = '';
      grid.innerHTML = '<div class="state"><div class="emoji">🛒</div><h2>Ende s\'ka oferta</h2><p>Kthehu pak më vonë — bizneset shtojnë oferta gjatë ditës.</p></div>';
      return;
    }
    grid.className = 'grid';
    grid.innerHTML = deals.map(dealCard).join('');
    // koppel claim-knoppen
    var btns = grid.querySelectorAll('.btn-claim');
    btns.forEach(function(b){
      b.addEventListener('click', function(){
        var id = b.getAttribute('data-id');
        var d = deals.filter(function(x){return x.id===id;})[0];
        if(d) openModal(d);
      });
    });
    // koppel kaart-knoppen (Google Maps)
    grid.querySelectorAll('.btn-map').forEach(function(b){
      b.addEventListener('click', function(){
        var q = b.getAttribute('data-mapq');
        if(q) window.open('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q), '_blank', 'noopener');
      });
    });
  }

  function showLoading(){
    var grid = document.getElementById('dealsGrid');
    grid.className = 'grid skeleton';
    var s='';
    for(var i=0;i<6;i++){ s += '<article class="card"><div class="card-media"></div><div class="card-body"><div class="ln" style="width:80%"></div><div class="ln" style="width:50%"></div><div class="ln" style="width:60%"></div></div></article>'; }
    grid.innerHTML = s;
  }

  function showError(){
    var grid = document.getElementById('dealsGrid');
    grid.className='';
    grid.innerHTML = '<div class="state"><div class="emoji">⚠️</div><h2>Nuk u ngarkuan ofertat</h2><p>Provo të rifreskosh faqen.</p></div>';
  }

  var allDeals = [];
  var allAds = [];
  var currentCity = '';

  function refreshAll(){
    buildCityFilter(allDeals.concat(allAds));
    applyFilter();
  }

  function loadDeals(){
    showLoading();
    fetch(API_BASE + '/api/deals')
      .then(function(r){ return r.json(); })
      .then(function(data){
        if(data && data.success){
          allDeals = data.deals || [];
          refreshAll();
        } else showError();
      })
      .catch(showError);
  }

  function buildCityFilter(deals){
    var bar = document.getElementById('cityFilter');
    if(!bar) return;
    var cities = [];
    deals.forEach(function(d){ if(d.city && cities.indexOf(d.city)===-1) cities.push(d.city); });
    cities.sort();
    if(cities.length===0){ bar.innerHTML=''; return; }
    var html = '<button class="city-chip'+(currentCity===''?' active':'')+'" data-city="">Të gjitha</button>';
    cities.forEach(function(c){ html += '<button class="city-chip'+(currentCity===c?' active':'')+'" data-city="'+esc(c)+'">'+esc(c)+'</button>'; });
    bar.innerHTML = html;
    bar.querySelectorAll('.city-chip').forEach(function(chip){
      chip.addEventListener('click', function(){
        currentCity = chip.getAttribute('data-city') || '';
        bar.querySelectorAll('.city-chip').forEach(function(c){ c.classList.remove('active'); });
        chip.classList.add('active');
        applyFilter();
      });
    });
  }

  function applyFilter(){
    var filtered = currentCity ? allDeals.filter(function(d){ return d.city === currentCity; }) : allDeals;
    render(filtered);
    var filteredAds = currentCity ? allAds.filter(function(a){ return a.city === currentCity; }) : allAds;
    renderAds(filteredAds);
  }

  // ---- Modal ----
  function openModal(d){
    currentDeal = d;
    document.getElementById('modalDeal').textContent = d.title;
    document.getElementById('modalForm').style.display='block';
    document.getElementById('modalSuccess').style.display='none';
    document.getElementById('cErr').style.display='none';
    document.getElementById('cName').value='';
    document.getElementById('cEmail').value='';
    document.getElementById('cPhone').value='';
    document.getElementById('cSubmit').disabled=false;
    document.getElementById('overlay').classList.add('open');
  }
  function closeModal(){
    document.getElementById('overlay').classList.remove('open');
    currentDeal=null;
  }
  document.getElementById('overlay').addEventListener('click', function(e){ if(e.target.id==='overlay') closeModal(); });
  document.addEventListener('keydown', function(e){ if(e.key==='Escape') closeModal(); });

  function submitClaim(){
    var name=document.getElementById('cName').value.trim();
    var email=document.getElementById('cEmail').value.trim();
    var phone=document.getElementById('cPhone').value.trim();
    if(!email && !phone){ document.getElementById('cErr').style.display='block'; return; }
    document.getElementById('cErr').style.display='none';
    var btn=document.getElementById('cSubmit'); btn.disabled=true; btn.textContent='Duke dërguar...';
    fetch(API_BASE + '/api/leads', {
      method:'POST',
      headers:{'Content-Type':'application/json'},
      body: JSON.stringify({
        type:'deal_claim', name:name, email:email, phone:phone,
        dealId: currentDeal? currentDeal.id : '',
        dealTitle: currentDeal? currentDeal.title : ''
      })
    })
    .then(function(r){ return r.json(); })
    .then(function(data){
      btn.textContent='Dërgo';
      if(data && data.success){
        var q = currentDeal ? mapQuery(currentDeal) : '';
        var mapUrl = q ? ('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q)) : '';
        var whereEl = document.getElementById('successWhere');
        var mapsBtn = document.getElementById('mapsBtn');
        if(currentDeal && (currentDeal.partnerName || currentDeal.city || currentDeal.address)){
          whereEl.textContent = '📍 ' + [currentDeal.partnerName, currentDeal.address || currentDeal.city].filter(Boolean).join(' · ');
          whereEl.style.display = 'block';
        } else { whereEl.style.display = 'none'; }
        if(mapUrl){
          mapsBtn.style.display = '';
          mapsBtn.onclick = function(){ window.open(mapUrl, '_blank', 'noopener'); };
        } else {
          mapsBtn.style.display = 'none';
        }
        document.getElementById('modalForm').style.display='none';
        document.getElementById('modalSuccess').style.display='block';
        if(mapUrl){ try { window.open(mapUrl, '_blank', 'noopener'); } catch(e){} }
      } else {
        document.getElementById('cErr').textContent=(data&&data.error)?data.error:'Diçka shkoi keq.';
        document.getElementById('cErr').style.display='block';
        btn.disabled=false;
      }
    })
    .catch(function(){
      document.getElementById('cErr').textContent='Lidhja dështoi. Provo përsëri.';
      document.getElementById('cErr').style.display='block';
      btn.disabled=false; btn.textContent='Dërgo';
    });
  }

  // ---- Reklama të promovuara (premium ads, zichtbaar voor klanten) ----
  var catEmojiAds = { food:'🍽️', bakery:'🥐', produce:'🍎', meat:'🥩', dairy:'🧀', other:'🍴' };
  function adCard(a){
    var media = a.imageUrl
      ? '<img src="'+esc(a.imageUrl)+'" alt="'+esc(a.title)+'" style="width:100%;height:100%;object-fit:cover">'
      : (catEmojiAds[a.category] || '⭐');
    var html = '<article class="card" style="border:2px solid #F5C518;box-shadow:0 6px 16px rgba(245,197,24,.28)">';
    html += '<div class="card-media">'+ media;
    html += '<span class="badge-discount" style="background:#F5C518;color:#3a2d00">⭐ E Promovuar</span>';
    html += '</div>';
    html += '<div class="card-body">';
    html += '<div class="card-title">'+esc(a.title)+'</div>';
    var meta = [];
    if(a.partnerName) meta.push(esc(a.partnerName));
    if(a.city) meta.push(esc(a.city));
    html += '<div class="card-meta">'+ meta.join(' <span class="sep">·</span> ') +'</div>';
    if(a.description) html += '<div class="card-desc">'+esc(a.description)+'</div>';
    if(a.price!=null && a.price!=='') html += '<div class="price-row"><span class="price-now">'+fmtPrice(a.price)+'</span></div>';
    var mapQ = ((a.partnerName||'') + ' ' + (a.city||'')).trim();
    html += '<div class="card-actions">';
    if(mapQ) html += '<button class="btn-map" type="button" data-mapq="'+esc(mapQ)+'" title="Shiko në hartë">📍 Hartë</button>';
    html += '<button class="btn-claim" type="button" data-id="'+esc(a.id)+'">E dua këtë</button>';
    html += '</div>';
    html += '</div></article>';
    return html;
  }
  function renderAds(ads){
    var sec = document.getElementById('promoSection');
    var grid = document.getElementById('promoGrid');
    if(!sec || !grid) return;
    if(!ads || ads.length===0){ sec.style.display='none'; grid.innerHTML=''; return; }
    sec.style.display='block';
    grid.innerHTML = ads.map(adCard).join('');
    grid.querySelectorAll('.btn-claim').forEach(function(b){
      b.addEventListener('click', function(){
        var id = b.getAttribute('data-id');
        var a = ads.filter(function(x){return x.id===id;})[0];
        if(a) openModal(a);
      });
    });
    grid.querySelectorAll('.btn-map').forEach(function(b){
      b.addEventListener('click', function(){
        var q = b.getAttribute('data-mapq');
        if(q) window.open('https://www.google.com/maps/search/?api=1&query=' + encodeURIComponent(q), '_blank', 'noopener');
      });
    });
  }
  function loadAds(){
    fetch(API_BASE + '/api/ads')
      .then(function(r){ return r.json(); })
      .then(function(data){ if(data && data.success){ allAds = data.ads || []; refreshAll(); } })
      .catch(function(){});
  }

  loadAds();
  loadDeals();
</script>
</body>
</html>
