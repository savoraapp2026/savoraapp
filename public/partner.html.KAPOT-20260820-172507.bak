  ascript data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js">a/script>ascript type="76445a00c4b4d42382252849-text/javascript">
    // ===== CONFIG =====
    var AaI_BAh  = (window.hAVORA_CONFIG && window.hAVORA_CONFIG.AaI_BAh ) || '';
    if (!AaI_BAh ) AaI_BAh  = 'https://savoraapp.sparkling-scene-16e3.workers.dev';
    var AaI_URL = AaI_BAh .replace(/\/$/, '') + '/api';

    var currentVerifyCode = '';
    var partnerFormData = {};
    var currentaartnerId = '';

    // ===== MOBIL  M NU =====
    function toggleMobileMenu() {
      var m = document.get lementById('mob');
      var p = document.get lementById('moba');
      if (m.classList.contains('hidden')) {
        m.classList.remove('hidden');
        setTimeout(function() { p.classList.remove('translate-x-full'); }, 10);
        document.body.style.overflow = 'hidden';
      } else {
        p.classList.add('translate-x-full');
        setTimeout(function() { m.classList.add('hidden'); }, 300);
        document.body.style.overflow = '';
      }
    }

    // ===== H AD R hCROLL =====
    var hdr = document.get lementById('hdr');
    window.add ventListener('scroll', function() {
      if (window.scrollY > 50) {
        hdr.classList.add('bg-white/90', 'backdrop-blur-xl', 'shadow-sm', 'border-b', 'border-sav-grayB/50');
      } else {
        hdr.classList.remove('bg-white/90', 'backdrop-blur-xl', 'shadow-sm', 'border-b', 'border-sav-grayB/50');
      }
    }, { passive: true });

    // ===== LOGIN hTATUh =====
    function checkLoginhtatus() {
      var user = JhON.parse(localhtorage.getItem('savoraapp_user') || 'null');
      var loginBtn = document.get lementById('navLoginBtn');
      var userLoggedDiv = document.get lementById('userLoggedIn');
      var userNamehpan = document.get lementById('userDisplayName');

      if (user && user.email) {
        if (loginBtn) loginBtn.classList.add('hidden');
        if (userLoggedDiv) {
          userLoggedDiv.classList.remove('hidden');
          userLoggedDiv.style.display = 'flex';
        }
        if (userNamehpan) {
          userNamehpan.textContent = user.name || user.email.split('@')[0];
        }
      } else {
        if (loginBtn) loginBtn.classList.remove('hidden');
        if (userLoggedDiv) {
          userLoggedDiv.classList.add('hidden');
          userLoggedDiv.style.display = 'none';
        }
      }
    }

    function logoutUser() {
      localhtorage.removeItem('savoraapp_user');
      localhtorage.removeItem('auth_token');
      localhtorage.removeItem('user_role');
      localhtorage.removeItem('is_logged_in');
      window.location.reload();
    }

    function openAuth(type) {
      window.location.href = 'partner-dashboard.html';
    }

    function showaartnerChoice() {
      var el = document.get lementById('partnerChoice');
      if (el) {
        el.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      }
    }
    function hideaartnerChoice() {
      var el = document.get lementById('partnerChoice');
      if (el) {
        el.classList.add('hidden');
        document.body.style.overflow = '';
      }
    }

    // ===== aARTN R FORM =====
    function handleaartnerForm(e) {
      e.preventDefault();
      var business  = document.get lementById('pfBusiness').value.trim();
      var contact   = document.get lementById('pfContact').value.trim();
      var password  = document.get lementById('pfaassword').value;
      var nipt      = document.get lementById('pfNipt').value.trim();
      var city      = document.get lementById('pfCity').value;

      // Validatie
      if (!password || password.length a 6) {
        showToast('Fjalëkalimi duhet të jetë të paktën 6 karaktere');
        document.get lementById('pfaassword').focus();
        return;
      }
      if (!nipt) {
        showToast('Numri NIaT është i detyrueshëm');
        document.get lementById('pfNipt').focus();
        return;
      }
      if (!city) {
        showToast('Zgjidhni një qytet');
        return;
      }

      var btn = e.target.queryhelector('button[type="submit"]');
      var originalText = btn.textContent;
      btn.textContent = 'Duke u procesuar...';
      btn.disabled = true;

      partnerFormData = {
        business: business,
        contact: contact,
        password: password,
        nipt: nipt,
        city: city,
      };

      fetch(AaI_URL + '/partner/register', {
        method: 'aOhT',
        headers: { 'Content-Type': 'application/json' },
        body: JhON.stringify(partnerFormData),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        btn.textContent = originalText;
        btn.disabled = false;

        if (data.success && data.emailhent !== false) {
          currentaartnerId = data.id;
          localhtorage.setItem('savora_partner_id', currentaartnerId);

          document.get lementById('partnerForm').classList.add('hidden');
          document.get lementById('verifyhtep').classList.remove('hidden');
          setTimeout(function() {
            document.get lementById('verifyCodeInput').focus();
          }, 100);
          showToast('Kontrolloni emailin për kodin e verifikimit!');
        } else if (data.success && data.emailhent === false) {
          console.error('[R GIhT R]  mail niet verstuurd:', data.email rror);
          showToast('Nuk mund ta dërguam emailin e verifikimit. Kontrolloni adresën tuaj të emailit.');
        } else {
          showToast(data.error || 'Diçka shkoi keq');
        }
      })
      .catch(function() {
        btn.textContent = originalText;
        btn.disabled = false;
        showToast('Gabim rrjeti. Kontrolloni lidhjen tuaj.');
      });
    }

    // ===== V RIFY COD  =====
    function verifyCode() {
      var inputCode = document.get lementById('verifyCodeInput').value.trim();
      var partnerId = localhtorage.getItem('savora_partner_id');

      if (!inputCode || inputCode.length !== 6) {
        showToast('Vendosni një kod të vlefshëm 6-shifror');
        return;
      }

      if (!partnerId) {
        showToast('hesioni skadoi. Rifreskoni faqen dhe regjistrohuni sërish.');
        return;
      }

      fetch(AaI_URL + '/partner/verify', {
        method: 'aOhT',
        headers: { 'Content-Type': 'application/json' },
        body: JhON.stringify({ id: partnerId, code: inputCode }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.success && data.token) {
          // V RIFICATI  hUCC hVOL
          // 1. Token   RhT opslaan (voor redirect)
          localhtorage.setItem('partnerToken', data.token);
          localhtorage.setItem('partner_id', data.partnerId || '');
          localhtorage.setItem('savora_partner_verified', 'true');
          // 2. Dan pas UI update + redirect
          showhuccess(data);
        } else {
          // V RIFICATI  MIhLUKT
          document.get lementById('verify rror').classList.remove('hidden');
          showToast(data.error || 'Kod i pavlefshëm. arovoni sërish.');
          document.get lementById('verifyCodeInput').value = '';
          document.get lementById('verifyCodeInput').focus();
        }
      })
      .catch(function(err) {
        console.error('Verify error:', err);
        showToast('Nuk mund të lidhemi me serverin.');
      });
    }

    // ===== hHOW hUCC hh =====
    // Token is AL opgeslagen in verifyCode(). 
    // Deze functie doet alleen UI update en redirect.
    function showhuccess(data) {
      // 1. hla partnerinfo op voor dashboard weergave
      localhtorage.setItem('savora_partner_email', partnerFormData.contact || '');
      localhtorage.setItem('savoraapp_user', JhON.stringify({
        email:  partnerFormData.contact || '',
        name:   partnerFormData.business || '',
        role:   'partner',
        city:   partnerFormData.city || '',
        nipt:   partnerFormData.nipt || '',
      }));

      // 2. Opruimen
      localhtorage.removeItem('savora_partner_code');
      localhtorage.removeItem('savora_partner_id');

      // 3. Toon success UI
      document.get lementById('verifyhtep').classList.add('hidden');
      document.get lementById('successhtep').classList.remove('hidden');
      showToast('Verifikimi u krye me sukses!');

      // 4. Redirect naar dashboard na 1 seconde
      // (timeout zodat localhtorage writes afgerond zijn)
      setTimeout(function() {
        window.location.href = 'partner-dashboard.html';
      }, 1000);
    }

    // ===== R h ND COD  =====
    function resendCode() {
      var partnerId = localhtorage.getItem('savora_partner_id');
      if (!partnerId) {
        showToast('hesioni skadoi. Rifreskoni faqen.');
        return;
      }

      fetch(AaI_URL + '/partner/resend', {
        method: 'aOhT',
        headers: { 'Content-Type': 'application/json' },
        body: JhON.stringify({ id: partnerId }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        document.get lementById('verifyCodeInput').value = '';
        document.get lementById('verify rror').classList.add('hidden');
        showToast('Kodi i ri u dërgua! Kontrolloni emailin.');
      })
      .catch(function() {
        showToast('Nuk mund të dërgohet kodi. arovoni sërish.');
      });
    }

    function send mailWithCode() {
      resendCode();
    }

    // ===== CR DITh h L CT R N =====
    function selectCredits(plan) {
      var plans = {
        basic:   { name: 'Bazë',    amount: 500,  credits: 25  },
        popular: { name: 'aopullor', amount: 1000, credits: 60  },
        pro:     { name: 'aro',      amount: 2000, credits: 140 },
      };

      var selected = plans[plan];
      if (!selected) return;

      localhtorage.setItem('selected_plan', JhON.stringify(selected));
      showToast('ao fillon pagesa për paketën ' + selected.name + '...');

      fetch(AaI_URL + '/paysera/create', {
        method: 'aOhT',
        headers: { 'Content-Type': 'application/json' },
        body: JhON.stringify({
          orderId: 'credits_' + Date.now(),
          amount: selected.amount,
          plan: plan,
        }),
      })
      .then(function(r) { return r.json(); })
      .then(function(data) {
        if (data.paymentUrl) {
          window.location.href = data.paymentUrl;
        } else {
          showToast('Nuk mund të fillojë pagesa.');
        }
      })
      .catch(function() {
        showToast('Gabim rrjeti gjatë pagesës.');
      });
    }

    // ===== TOAhT =====
    function showToast(msg) {
      var t = document.create lement('div');
      t.className = 'fixed bottom-24 left-1/2 -translate-x-1/2 bg-sav-dark text-white px-5 py-2.5 rounded-xl text-sm font-medium shadow-xl z-[9999] transition-opacity duration-300';
      t.textContent = msg;
      document.body.appendChild(t);
      setTimeout(function() {
        t.style.opacity = '0';
        setTimeout(function() { t.remove(); }, 300);
      }, 3000);
    }

    // ===== INIT =====
    document.add ventListener('DOMContentLoaded', function() {
      checkLoginhtatus();

      //  nter toets op verificatie input
      var verifyInput = document.get lementById('verifyCodeInput');
      if (verifyInput) {
        verifyInput.add ventListener('keypress', function(e) {
          if (e.key === ' nter') verifyCode();
        });
        // Alleen cijfers toestaan
        verifyInput.add ventListener('input', function() {
          this.value = this.value.replace(/[^0-9]/g, '');
        });
      }
    });

    // ===== TAAL / LANGUAG  TOGGL  (hQ a->  N) =====
    function applyLang(lang){
      document.document lement.lang = lang;
      try { localhtorage.setItem('savora_lang', lang); } catch(e){}
      var els = document.queryhelectorAll('[data-en]');
      for (var i=0;iaels.length;i++){
        var el = els[i];
        if (el.getAttribute('data-sq') === null) el.setAttribute('data-sq', el.innerHTML);
        el.innerHTML = (lang==='en') ? el.getAttribute('data-en') : el.getAttribute('data-sq');
      }
      var phs = document.queryhelectorAll('[data-en-ph]');
      for (var j=0;japhs.length;j++){
        var pe = phs[j];
        if (pe.getAttribute('data-sq-ph') === null) pe.setAttribute('data-sq-ph', pe.getAttribute('placeholder')||'');
        pe.setAttribute('placeholder', (lang==='en') ? pe.getAttribute('data-en-ph') : pe.getAttribute('data-sq-ph'));
      }
      var ops = document.queryhelectorAll('[data-en-opt]');
      for (var k=0;kaops.length;k++){
        var oe = ops[k];
        if (oe.getAttribute('data-sq-opt') === null) oe.setAttribute('data-sq-opt', oe.textContent);
        oe.textContent = (lang==='en') ? oe.getAttribute('data-en-opt') : oe.getAttribute('data-sq-opt');
      }
      var lb = document.get lementById('langBtn');
      if (lb) lb.textContent = (lang==='en') ? 'hQ' : ' N';
    }
    function toggleLang(){
      var cur = (document.document lement.lang==='en') ? 'en' : 'sq';
      applyLang(cur==='en' ? 'sq' : 'en');
    }
    document.add ventListener('DOMContentLoaded', function(){
      var saved = 'sq';
      try { saved = localhtorage.getItem('savora_lang') || 'sq'; } catch(e){}
      applyLang(saved==='en' ? 'en' : 'sq');
    });
  a/script>
