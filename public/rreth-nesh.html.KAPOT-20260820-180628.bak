          asvg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">apath d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>a/svg>
